{
  "name": "palomares-del-campo",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck:astro": "astro check",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck": "pnpm run typecheck:astro && pnpm run typecheck:convex",
    "fetch-bandos": "tsx scripts/fetch-bandos.ts",
    "sync-agenda-from-bandos": "tsx scripts/sync-agenda-from-bandos.ts",
    "sync-bandos": "bash scripts/sync-bandos-cron.sh",
    "discover-news": "bash scripts/run-news-discovery.sh",
    "discover-news:dry-run": "bash scripts/run-news-discovery.sh --dry-run",
    "preview": "astro preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa:visual": "tsx scripts/visual-qa.ts",
    "check:css:architecture": "tsx scripts/check-css-architecture.ts",
    "check:seo": "tsx scripts/verify-seo.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/leaflet": "1.9.20",
    "astro": "7.3.8",
    "convex": "1.46.0",
    "dotenv": "17.2.3",
    "leaflet": "1.9.4",
    "nodemailer": "10.0.10",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "convex-test": "0.0.62",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
