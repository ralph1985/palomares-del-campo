---
import WorldMap from '../../components/world/WorldMap.astro';
import WorldSubmissionForm from '../../components/world/WorldSubmissionForm.astro';
import EditorialHero from '../../components/hero/EditorialHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Palomareños por el mundo · Palomares del Campo"
  description="Mapa de historias de personas vinculadas a Palomares del Campo que viven fuera."
>
  <main>
    <EditorialHero labelledBy="page-title" variant="sage-display" titleWidth="narrow">
      <p slot="eyebrow" class="eyebrow">
        Palomares del Campo · Comunidad
      </p>
      <h1 slot="title" id="page-title">
        Palomareños por el mundo
      </h1>
      <p slot="summary" class="hero-intro">
        El pueblo también se extiende allí donde viven quienes lo llevan consigo. Descubre sus
        historias y comparte la tuya.
      </p>
    </EditorialHero>

    <section class="world-intro" aria-labelledby="intro-title">
      <div class="world-shell world-intro-grid">
        <div>
          <p class="eyebrow">Una red de vínculos</p>
          <h2 id="intro-title">Distancia no siempre significa desconexión.</h2>
        </div>
        <div class="world-copy">
          <p>
            Este mapa reúne, poco a poco, a personas vinculadas a Palomares del Campo que viven en
            otras ciudades y países.
          </p>
          <p>
            Las historias se revisan antes de publicarse. Mostramos solo la ciudad aproximada y los
            datos que cada persona elige compartir; nunca una dirección personal.
          </p>
        </div>
      </div>
    </section>

    <section class="world-map-section" aria-labelledby="map-section-title">
      <div class="world-shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Historias aprobadas</p>
            <h2 id="map-section-title">Un pueblo con muchos puntos cardinales.</h2>
          </div>
          <p>Abre cada punto para conocer la historia que hay detrás.</p>
        </div>
        <WorldMap />
      </div>
    </section>

    <section class="world-form-section" aria-labelledby="form-section-title">
      <div class="world-shell">
        <WorldSubmissionForm />
      </div>
    </section>

    <section class="world-note-section" aria-label="Privacidad y revisión">
      <div class="world-shell">
        <p>
          Las propuestas se revisan manualmente. El email se utiliza solo para contacto y no se
          publica en el mapa. Puedes solicitar una corrección o la retirada de tu historia.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .world-shell {
    width: min(100% - 2.5rem, 76rem);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-clay);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  h2 {
    max-width: 14ch;
    font-size: clamp(2.4rem, 5vw, 5rem);
  }

  .world-intro,
  .world-map-section,
  .world-form-section {
    padding: clamp(4.5rem, 10vw, 8rem) 0;
  }

  .world-intro-grid,
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .world-copy,
  .section-heading > p {
    max-width: 40rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .world-copy p {
    margin: 0;
  }

  .world-copy p + p {
    margin-top: 1.1rem;
  }

  .world-map-section {
    background: var(--color-paper);
  }

  .section-heading {
    align-items: end;
    margin-bottom: 2rem;
  }

  .section-heading > p {
    margin-bottom: 0.35rem;
  }

  .world-form-section {
    background: var(--color-sage-light);
  }

  .world-note-section {
    padding: 2rem 0;
    color: var(--color-night-text);
    background: var(--color-night-surface);
  }

  .world-note-section p {
    max-width: 52rem;
    margin: 0;
    line-height: 1.65;
  }

  @media (max-width: 48rem) {
    .world-intro-grid,
    .section-heading {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
