---
import WorldMap from '../../components/world/WorldMap.astro';
import WorldSubmissionForm from '../../components/world/WorldSubmissionForm.astro';
import EditorialHero from '../../components/hero/EditorialHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUBLIC_PALOMARENOS_ENABLED } from 'astro:env/client';

const palomarenosEnabled = PUBLIC_PALOMARENOS_ENABLED;
const pageDescription = palomarenosEnabled
  ? 'Mapa de historias de personas vinculadas a Palomares del Campo que viven fuera.'
  : 'Sección en preparación sobre personas vinculadas a Palomares del Campo que viven fuera.';
---

<BaseLayout
  title="Palomareños por el mundo · Palomares del Campo"
  description={pageDescription}
  noindex={!palomarenosEnabled}
>
  <main>
    <EditorialHero labelledBy="page-title" variant="sage" titleWidth="narrow">
      <p slot="eyebrow" class="eyebrow">
        Palomares del Campo · Comunidad
      </p>
      <h1 slot="title" id="page-title">
        Palomareños por el mundo
      </h1>
      <p slot="summary" class="hero-intro">
        {palomarenosEnabled
          ? 'Historias de personas vinculadas a Palomares del Campo que viven en otros lugares. Lee sus relatos o comparte el tuyo.'
          : 'Estamos preparando un espacio para reunir historias de personas vinculadas a Palomares del Campo que viven fuera.'}
      </p>
    </EditorialHero>

    {palomarenosEnabled ? (
      <>
        <section class="world-intro" aria-labelledby="intro-title">
          <div class="world-shell world-intro-grid">
            <div>
              <p class="eyebrow">Una red de vínculos</p>
              <h2 id="intro-title">Personas de Palomares que viven fuera.</h2>
            </div>
            <div class="world-copy">
              <p>
                Este mapa reúne, poco a poco, a personas vinculadas a Palomares del Campo que viven
                en otras ciudades y países.
              </p>
              <p>
                Las historias se revisan antes de publicarse. Mostramos solo la ciudad aproximada y
                los datos que cada persona elige compartir; nunca una dirección personal.
              </p>
            </div>
          </div>
        </section>

        <section class="world-map-section" aria-labelledby="map-section-title">
          <div class="world-shell">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Historias aprobadas</p>
                <h2 id="map-section-title">Historias desde otros lugares.</h2>
              </div>
              <p>Abre cada punto para conocer la historia que hay detrás.</p>
            </div>
            <WorldMap />
          </div>
        </section>

        <section class="world-form-section" aria-labelledby="form-section-title">
          <div class="world-shell">
            <WorldSubmissionForm />
          </div>
        </section>

        <section class="world-note-section" aria-label="Privacidad y revisión">
          <div class="world-shell">
            <p>
              Las propuestas se revisan manualmente. El email se utiliza solo para contacto y no se
              publica en el mapa. Puedes solicitar una corrección o la retirada de tu historia.
            </p>
          </div>
        </section>
      </>
    ) : (
      <section class="world-disabled" aria-labelledby="world-disabled-title">
        <div class="world-shell world-disabled-content">
          <p class="eyebrow">Propuesta para decisión municipal · Estado: no activa</p>
          <h2 id="world-disabled-title">Una red de vínculos con Palomares</h2>
          <p>
            «Palomareños por el mundo» podría reunir relatos voluntarios de personas que mantienen
            un vínculo con el municipio y viven en otros lugares. El objetivo sería acercar esas
            experiencias a la comunidad, no localizar a nadie ni crear un directorio exhaustivo.
          </p>
          <p class="proposal-status">
            <strong>Presentación estática.</strong> No hay mapa, formulario, envío ni historias
            publicadas.
          </p>

          <div class="proposal-grid">
            <article>
              <h3>Qué podría proponerse</h3>
              <p>De forma opcional y sujeta a aprobación, una ficha podría incluir:</p>
              <ul>
                <li>nombre mostrado elegido por la persona, o seudónimo;</li>
                <li>ciudad y país, sin dirección ni ubicación exacta;</li>
                <li>un relato breve sobre su vínculo con Palomares;</li>
                <li>una imagen, solo si se decide admitirla y se aclaran sus condiciones.</li>
              </ul>
              <p>Estos son campos hipotéticos; esta página no los recoge.</p>
            </article>
            <article>
              <h3>Qué sería público</h3>
              <p>
                Solo tras una aprobación expresa podrían mostrarse el nombre elegido, la ciudad y el
                país, el texto autorizado y, si se aprobara, una ubicación aproximada. El email de
                contacto y cualquier nota de revisión no serían públicos. No se publicarían
                domicilios ni coordenadas precisas.
              </p>
            </article>
            <article>
              <h3>Revisión y solicitudes</h3>
              <p>
                La propuesta contempla revisión humana antes de cualquier publicación. Habría que
                definir quién modera, cómo se autorizan cambios y qué canal verificable atendería
                solicitudes de corrección o retirada. No existe todavía un canal de envío para esta
                propuesta.
              </p>
            </article>
            <article>
              <h3>Decisiones pendientes</h3>
              <p>
                El Ayuntamiento tendría que aprobar el alcance, quién se responsabiliza, los motivos
                legales para tratar la información, los plazos de conservación, los servicios
                implicados y el procedimiento para atender solicitudes. Esta presentación no
                constituye una autorización ni un aviso legal definitivo.
              </p>
            </article>
          </div>
          <!-- TODO(AYTO)[PAL-01]: Aprobar inclusión de la sección, campos, datos públicos, moderación, marco legal y privacidad antes de habilitar mapa o formulario. -->
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .world-shell {
    width: min(100% - 2.5rem, 76rem);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-clay-text);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  h2 {
    max-width: 14ch;
    font-size: var(--font-size-section-heading);
  }

  .world-intro,
  .world-map-section,
  .world-form-section,
  .world-disabled {
    padding: var(--spacing-section-y) 0;
  }

  .world-disabled {
    background: var(--color-paper);
  }

  .world-disabled-content {
    max-width: 66rem;
  }

  .world-disabled-content > p:not(.eyebrow) {
    max-width: 50rem;
    margin: 1.25rem 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .proposal-status {
    padding: 0.9rem 1rem;
    border-left: 3px solid var(--color-clay-text);
    background: var(--color-surface);
  }

  .proposal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .proposal-grid article {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
  }

  .proposal-grid h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .proposal-grid p,
  .proposal-grid li {
    color: var(--color-muted);
    line-height: 1.65;
  }

  .proposal-grid p {
    margin: 0.8rem 0 0;
  }

  .proposal-grid ul {
    padding-left: 1.25rem;
  }

  .world-intro-grid,
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .world-copy,
  .section-heading > p {
    max-width: 40rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .world-copy p {
    margin: 0;
  }

  .world-copy p + p {
    margin-top: 1.1rem;
  }

  .world-map-section {
    background: var(--color-paper);
  }

  .section-heading {
    align-items: end;
    margin-bottom: 2rem;
  }

  .section-heading > p {
    margin-bottom: 0.35rem;
  }

  .world-form-section {
    background: var(--color-sage-light);
  }

  .world-note-section {
    padding: 2rem 0;
    color: var(--color-night-text);
    background: var(--color-night-surface);
  }

  .world-note-section p {
    max-width: 52rem;
    margin: 0;
    line-height: 1.65;
  }

  @media (max-width: 48rem) {
    .world-intro-grid,
    .section-heading,
    .proposal-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
