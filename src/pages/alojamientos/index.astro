---
import ExternalLink from '../../components/ui/ExternalLink.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import { accommodationReviewedAt, ruralAccommodations } from '../../data/accommodations';
import '../../styles/global.css';

const localAccommodations = ruralAccommodations.filter(
  (accommodation) => accommodation.area === 'Palomares del Campo',
);
const nearbyAccommodations = ruralAccommodations.filter(
  (accommodation) => accommodation.area === 'Alrededores',
);
const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Directorio informativo de casas rurales y otros alojamientos en Palomares del Campo y localidades cercanas."
    />
    <title>Alojamientos rurales · Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="accommodation-hero" aria-labelledby="page-title">
        <div class="accommodation-shell">
          <p class="eyebrow">Palomares del Campo · Visita</p>
          <h1 id="page-title">Alojamientos rurales</h1>
          <p>
            Una selección de casas rurales y alojamientos de Palomares del Campo y su entorno para
            empezar a organizar una visita con información visible y enlaces de origen.
          </p>
        </div>
      </section>

      <section class="criteria-section" aria-labelledby="criteria-title">
        <div class="accommodation-shell criteria-grid">
          <div>
            <p class="eyebrow">Directorio informativo</p>
            <h2 id="criteria-title">Dormir cerca también forma parte del viaje.</h2>
          </div>
          <div class="criteria-copy">
            <p>
              La primera búsqueda localiza una casa rural en Palomares del Campo y varias opciones
              en localidades cercanas como Carrascosa del Campo, El Hito, Saelices, Uclés y Huete.
            </p>
            <p>
              Los datos resumidos proceden de las fichas enlazadas. No mostramos precios ni
              prometemos disponibilidad: conviene confirmar directamente cada condición antes de
              reservar.
            </p>
          </div>
        </div>
      </section>

      <section class="list-section" aria-labelledby="local-title">
        <div class="accommodation-shell">
          <div class="section-heading">
            <p class="eyebrow">Dentro del municipio</p>
            <h2 id="local-title">Palomares del Campo</h2>
          </div>
          <div class="accommodation-grid">
            {localAccommodations.map((accommodation) => (
              <article class="accommodation-card" data-accommodation-card>
                <p class="accommodation-category">{accommodation.category}</p>
                <h3>{accommodation.name}</h3>
                <p class="accommodation-location">{accommodation.location}</p>
                <p class="accommodation-summary">{accommodation.summary}</p>
                <dl class="accommodation-facts">
                  <div>
                    <dt>Capacidad</dt>
                    <dd>{accommodation.capacity}</dd>
                  </div>
                  {accommodation.rooms && (
                    <div>
                      <dt>Distribución</dt>
                      <dd>{accommodation.rooms}</dd>
                    </div>
                  )}
                  {accommodation.bathrooms && (
                    <div>
                      <dt>Baños</dt>
                      <dd>{accommodation.bathrooms}</dd>
                    </div>
                  )}
                </dl>
                <div class="accommodation-links">
                  <ExternalLink href={accommodation.source.href}>
                    {accommodation.source.label} <span aria-hidden="true">↗</span>
                  </ExternalLink>
                  {accommodation.officialSource && (
                    <ExternalLink href={accommodation.officialSource.href}>
                      {accommodation.officialSource.label} <span aria-hidden="true">↗</span>
                    </ExternalLink>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="nearby-section" aria-labelledby="nearby-title">
        <div class="accommodation-shell">
          <div class="section-heading">
            <p class="eyebrow">A poca distancia</p>
            <h2 id="nearby-title">Alrededores</h2>
            <p>
              Opciones en municipios próximos que pueden completar la visita a Palomares y a otros
              puntos de interés de la comarca.
            </p>
          </div>
          <div class="accommodation-grid">
            {nearbyAccommodations.map((accommodation) => (
              <article class="accommodation-card" data-accommodation-card>
                <p class="accommodation-category">{accommodation.category}</p>
                <h3>{accommodation.name}</h3>
                <p class="accommodation-location">{accommodation.location}</p>
                <p class="accommodation-summary">{accommodation.summary}</p>
                <dl class="accommodation-facts">
                  <div>
                    <dt>Capacidad</dt>
                    <dd>{accommodation.capacity}</dd>
                  </div>
                  {accommodation.rooms && (
                    <div>
                      <dt>Distribución</dt>
                      <dd>{accommodation.rooms}</dd>
                    </div>
                  )}
                  {accommodation.bathrooms && (
                    <div>
                      <dt>Baños</dt>
                      <dd>{accommodation.bathrooms}</dd>
                    </div>
                  )}
                </dl>
                <div class="accommodation-links">
                  <ExternalLink href={accommodation.source.href}>
                    {accommodation.source.label} <span aria-hidden="true">↗</span>
                  </ExternalLink>
                  {accommodation.officialSource && (
                    <ExternalLink href={accommodation.officialSource.href}>
                      {accommodation.officialSource.label} <span aria-hidden="true">↗</span>
                    </ExternalLink>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="source-section" aria-label="Criterio y fecha de revisión">
        <div class="accommodation-shell source-inner">
          <p>
            No gestionamos reservas ni representamos a estos alojamientos. Los nombres, ubicaciones
            y capacidades pueden cambiar; comprueba precios, disponibilidad, dirección y condiciones
            en la fuente original antes de tomar una decisión.
          </p>
          <p>Fuentes consultadas y fichas revisadas el {formatDate(accommodationReviewedAt)}.</p>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .accommodation-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .accommodation-hero {
    padding: clamp(5rem, 12vw, 9rem) 0 clamp(4rem, 9vw, 7rem);
    background: #d8e6d6;
  }

  .eyebrow,
  .accommodation-category {
    margin: 0 0 1.25rem;
    color: #a05c32;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  h1 {
    max-width: 11ch;
    font-size: clamp(3.3rem, 8vw, 7.5rem);
  }

  h2 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5vw, 5rem);
  }

  .accommodation-hero > .accommodation-shell > p:last-child {
    max-width: 38rem;
    margin: 2rem 0 0;
    color: #527066;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .criteria-section,
  .list-section,
  .nearby-section {
    padding: clamp(4.5rem, 10vw, 8rem) 0;
  }

  .criteria-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .criteria-copy {
    max-width: 39rem;
    color: #527066;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .criteria-copy p {
    margin: 0;
  }

  .criteria-copy p + p {
    margin-top: 1.1rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .section-heading .eyebrow {
    margin-bottom: 0.85rem;
  }

  .section-heading > p:last-child {
    max-width: 30rem;
    margin: 0;
    color: #527066;
    line-height: 1.65;
  }

  .accommodation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .accommodation-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid rgb(25 52 45 / 15%);
    border-radius: 1.25rem;
    background: #fbfaf5;
  }

  .accommodation-category {
    margin-bottom: 1rem;
    font-size: 0.65rem;
  }

  .accommodation-card h3 {
    max-width: 18ch;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  .accommodation-location {
    margin: 0.7rem 0 0;
    color: #a05c32;
    font-weight: 750;
  }

  .accommodation-summary {
    margin: 1.2rem 0 0;
    color: #527066;
    line-height: 1.6;
  }

  .accommodation-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 1.5rem 0 0;
    padding: 1rem 0;
    border-top: 1px solid rgb(25 52 45 / 13%);
    border-bottom: 1px solid rgb(25 52 45 / 13%);
  }

  .accommodation-facts div {
    min-width: 0;
  }

  .accommodation-facts dt {
    color: #527066;
    font-size: 0.7rem;
    line-height: 1.3;
  }

  .accommodation-facts dd {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.35;
  }

  .accommodation-links {
    display: grid;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .accommodation-links a {
    color: #2f6652;
    font-size: 0.88rem;
    font-weight: 750;
    text-underline-offset: 0.25em;
  }

  .accommodation-links a:hover,
  .accommodation-links a:focus-visible {
    color: #a05c32;
  }

  .nearby-section {
    color: #eff5ed;
    background: #19342d;
  }

  .nearby-section .eyebrow,
  .nearby-section .section-heading > p:last-child {
    color: #e5b77e;
  }

  .nearby-section h2 {
    color: #fff;
  }

  .nearby-section .accommodation-card {
    border-color: rgb(239 245 237 / 18%);
    color: #19342d;
  }

  .source-section {
    color: #527066;
    background: #f4f1e9;
  }

  .source-inner {
    padding: 1.5rem 0 2rem;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .source-inner p {
    margin: 0;
  }

  .source-inner p + p {
    margin-top: 0.45rem;
  }

  @media (max-width: 50rem) {
    .criteria-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .section-heading {
      display: block;
    }

    .section-heading > p:last-child {
      margin-top: 1.2rem;
    }
  }

  @media (max-width: 42rem) {
    .accommodation-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .accommodation-shell {
      width: min(100% - 2rem, 72rem);
    }

    .accommodation-facts {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }
</style>
