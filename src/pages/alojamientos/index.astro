---
import AccommodationCard from '../../components/accommodations/AccommodationCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { accommodationReviewedAt, ruralAccommodations } from '../../data/accommodations';

const localAccommodations = ruralAccommodations.filter(
  (accommodation) => accommodation.area === 'Palomares del Campo',
);
const nearbyAccommodations = ruralAccommodations.filter(
  (accommodation) => accommodation.area === 'Alrededores',
);
const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<BaseLayout
  title="Alojamientos rurales · Palomares del Campo"
  description="Directorio informativo de casas rurales y otros alojamientos en Palomares del Campo y localidades cercanas."
>
  <main>
    <section class="accommodation-hero" aria-labelledby="page-title">
      <div class="accommodation-shell">
        <p class="eyebrow">Palomares del Campo · Visita</p>
        <h1 id="page-title">Alojamientos rurales</h1>
        <p>
          Una selección de casas rurales y alojamientos de Palomares del Campo y su entorno para
          empezar a organizar una visita con información visible y enlaces de origen.
        </p>
      </div>
    </section>

    <section class="criteria-section" aria-labelledby="criteria-title">
      <div class="accommodation-shell criteria-grid">
        <div>
          <p class="eyebrow">Directorio informativo</p>
          <h2 id="criteria-title">Dormir cerca también forma parte del viaje.</h2>
        </div>
        <div class="criteria-copy">
          <p>
            La primera búsqueda localiza una casa rural en Palomares del Campo y varias opciones en
            localidades cercanas como Carrascosa del Campo, El Hito, Saelices, Uclés y Huete.
          </p>
          <p>
            Los datos resumidos proceden de las fichas enlazadas. No mostramos precios ni prometemos
            disponibilidad: conviene confirmar directamente cada condición antes de reservar.
          </p>
        </div>
      </div>
    </section>

    <section class="list-section" aria-labelledby="local-title">
      <div class="accommodation-shell">
        <div class="section-heading">
          <p class="eyebrow">Dentro del municipio</p>
          <h2 id="local-title">Palomares del Campo</h2>
        </div>
        <div class="accommodation-grid">
          {localAccommodations.map((accommodation) => (
            <AccommodationCard accommodation={accommodation} />
          ))}
        </div>
      </div>
    </section>

    <section class="nearby-section" aria-labelledby="nearby-title">
      <div class="accommodation-shell">
        <div class="section-heading">
          <p class="eyebrow">A poca distancia</p>
          <h2 id="nearby-title">Alrededores</h2>
          <p>
            Opciones en municipios próximos que pueden completar la visita a Palomares y a otros
            puntos de interés de la comarca.
          </p>
        </div>
        <div class="accommodation-grid">
          {nearbyAccommodations.map((accommodation) => (
            <AccommodationCard accommodation={accommodation} variant="dark" />
          ))}
        </div>
      </div>
    </section>

    <section class="source-section" aria-label="Criterio y fecha de revisión">
      <div class="accommodation-shell source-inner">
        <p>
          No gestionamos reservas ni representamos a estos alojamientos. Los nombres, ubicaciones y
          capacidades pueden cambiar; comprueba precios, disponibilidad, dirección y condiciones en
          la fuente original antes de tomar una decisión.
        </p>
        <p>Fuentes consultadas y fichas revisadas el {formatDate(accommodationReviewedAt)}.</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .accommodation-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .accommodation-hero {
    padding: clamp(5rem, 12vw, 9rem) 0 clamp(4rem, 9vw, 7rem);
    background: var(--color-sage);
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-clay);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  h1 {
    max-width: 11ch;
    font-size: clamp(3.3rem, 8vw, 7.5rem);
  }

  h2 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5vw, 5rem);
  }

  .accommodation-hero > .accommodation-shell > p:last-child {
    max-width: 38rem;
    margin: 2rem 0 0;
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .criteria-section,
  .list-section,
  .nearby-section {
    padding: clamp(4.5rem, 10vw, 8rem) 0;
  }

  .criteria-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .criteria-copy {
    max-width: 39rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .criteria-copy p {
    margin: 0;
  }

  .criteria-copy p + p {
    margin-top: 1.1rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .section-heading .eyebrow {
    margin-bottom: 0.85rem;
  }

  .section-heading > p:last-child {
    max-width: 30rem;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .accommodation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .nearby-section {
    color: var(--color-surface-soft);
    background: var(--color-ink);
  }

  .nearby-section .eyebrow,
  .nearby-section .section-heading > p:last-child {
    color: var(--color-ochre);
  }

  .nearby-section h2 {
    color: var(--color-surface-soft);
  }

  .source-section {
    color: var(--color-muted);
    background: var(--color-paper);
  }

  .source-inner {
    padding: 1.5rem 0 2rem;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .source-inner p {
    margin: 0;
  }

  .source-inner p + p {
    margin-top: 0.45rem;
  }

  @media (max-width: 50rem) {
    .criteria-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .section-heading {
      display: block;
    }

    .section-heading > p:last-child {
      margin-top: 1.2rem;
    }
  }

  @media (max-width: 42rem) {
    .accommodation-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .accommodation-shell {
      width: min(100% - 2rem, 72rem);
    }

    .accommodation-facts {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }
</style>
