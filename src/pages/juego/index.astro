---
import SiteFooter from '../../components/layout/SiteFooter.astro';
import GameMap from '../../components/game/GameMap.astro';
import GameRules from '../../components/game/GameRules.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Prototipo del juego de geoposicionamiento de Palomares del Campo."
    />
    <title>La bola · Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="game-hero" aria-labelledby="page-title">
        <div class="game-hero-inner">
          <p class="eyebrow">Una partida que recorre el pueblo</p>
          <h1 id="page-title">Encuentra la bola.</h1>
          <p>
            Ve a la coordenada, demuestra que estás allí y captura la bola antes de que alguien se
            te adelante.
          </p>
        </div>
      </section>

      <GameMap />
      <GameRules />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #eff5ed;
    background: #10231f;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }

  main {
    overflow: hidden;
    background: #10231f;
  }

  .game-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(2.5rem, 6vw, 4.5rem);
    color: #eff5ed;
    background:
      radial-gradient(circle at 85% 30%, rgb(47 102 82 / 28%), transparent 24rem), #19342d;
  }

  .game-hero::after {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(239 245 237 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(239 245 237 / 4%) 1px, transparent 1px);
    background-size: 3rem 3rem;
    content: '';
    mask-image: linear-gradient(to right, rgb(0 0 0 / 80%), transparent 75%);
    pointer-events: none;
  }

  .game-hero-inner {
    position: relative;
    z-index: 1;
    width: min(100% - 2rem, 80rem);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #e5b77e;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 8ch;
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(4rem, 11vw, 8rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .game-hero p:last-child {
    max-width: 34rem;
    margin: 2rem 0 0;
    color: #b7d0bc;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.65;
  }

  @media (max-width: 38rem) {
    .game-hero-inner {
      width: min(100% - 2rem, 72rem);
    }
  }
</style>
