---
import SiteFooter from '../../components/layout/SiteFooter.astro';
import GameMap from '../../components/game/GameMap.astro';
import GameRules from '../../components/game/GameRules.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
const hasRemoteGame = Boolean(import.meta.env.CONVEX_URL);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Prototipo del juego de geoposicionamiento de Palomares del Campo."
    />
    <title>La bola · Palomares del Campo</title>
  </head>
  <body class="game-page">
    <SiteHeader />

    <main>
      <section class="game-hero" aria-labelledby="page-title">
        <div class="game-hero-inner">
          <div class="game-hero-copy">
            <div class="game-kicker">
              <span aria-hidden="true"></span>
              {hasRemoteGame ? 'Partida en directo · Palomares' : 'Modo local · Palomares'}
            </div>
            <h1 id="page-title">
              La bola está
              <br />
              en juego.
            </h1>
            <p>Encuentra la ubicación. Llega antes que el resto. Captura y sube puestos.</p>
            <a class="game-hero-cta" href="#game-map">
              Entrar en la partida <span aria-hidden="true">↓</span>
            </a>
          </div>

          <div class="match-card" aria-label="Estado de la partida">
            <div class="match-card-topline">
              <span class="match-card-live">
                <span aria-hidden="true"></span>
                {hasRemoteGame ? 'LIVE MATCH' : 'LOCAL MATCH'}
              </span>
              <span>EU · 01</span>
            </div>
            <strong>LA BOLA</strong>
            <p>El objetivo cambia de punto cuando alguien captura.</p>
            <div class="match-card-stats">
              <span>
                <small>FORMATO</small>
                <b>GPS / REAL</b>
              </span>
              <span>
                <small>ESTADO</small>
                <b>{hasRemoteGame ? 'EN JUEGO' : 'DEMO LOCAL'}</b>
              </span>
            </div>
          </div>
        </div>
      </section>

      <GameMap />
      <GameRules />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #eff5ed;
    background: #0a1513;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }

  main {
    overflow: hidden;
    background: #0a1513;
  }

  :global(.game-page .site-header) {
    position: sticky;
    z-index: 1100;
    isolation: isolate;
    border-bottom-color: rgb(239 245 237 / 10%);
    background: #0a1513;
  }

  :global(.game-page .site-header .brand),
  :global(.game-page .site-header .menu-toggle) {
    color: #eff5ed;
  }

  :global(.game-page .site-header .menu-toggle-icon span) {
    background: #e5b77e;
  }

  :global(.game-page .site-header .header-inner) {
    min-height: 4rem;
  }

  .game-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(2rem, 4vw, 3.25rem);
    color: #eff5ed;
    background:
      radial-gradient(circle at 85% 30%, rgb(47 102 82 / 28%), transparent 24rem), #19342d;
  }

  .game-hero::after {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(239 245 237 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(239 245 237 / 4%) 1px, transparent 1px);
    background-size: 3rem 3rem;
    content: '';
    mask-image: linear-gradient(to right, rgb(0 0 0 / 80%), transparent 75%);
    pointer-events: none;
  }

  .game-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 8rem);
    width: min(100% - 2rem, 80rem);
    margin: 0 auto;
  }

  .game-kicker {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1rem;
    color: #e5b77e;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .game-kicker span,
  .match-card-live span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #e5b77e;
    box-shadow: 0 0 0 0.25rem rgb(229 183 126 / 14%);
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-family: inherit;
    font-size: clamp(3.5rem, 8vw, 6.8rem);
    font-weight: 850;
    letter-spacing: -0.08em;
    line-height: 0.86;
  }

  .game-hero-copy > p {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: #b7d0bc;
    font-size: 1rem;
    line-height: 1.5;
  }

  .game-hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(229 183 126 / 45%);
    border-radius: 0.55rem;
    color: #19342d;
    background: #e5b77e;
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
  }

  .game-hero-cta:hover {
    background: #f0c995;
  }

  .match-card {
    padding: 1.1rem;
    border: 1px solid rgb(239 245 237 / 16%);
    border-radius: 0.8rem;
    background: rgb(239 245 237 / 5%);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 16%);
  }

  .match-card-topline,
  .match-card-stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: #8fb49c;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .match-card-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #e5b77e;
  }

  .match-card strong {
    display: block;
    margin-top: 2.5rem;
    color: #eff5ed;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 850;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .match-card p {
    max-width: 18rem;
    margin: 0.8rem 0 2rem;
    color: #b7d0bc;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .match-card-stats {
    align-items: end;
    padding-top: 0.8rem;
    border-top: 1px solid rgb(239 245 237 / 12%);
  }

  .match-card-stats span {
    display: grid;
    gap: 0.25rem;
  }

  .match-card-stats b {
    color: #eff5ed;
    font-size: 0.72rem;
  }

  @media (max-width: 38rem) {
    .game-hero-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      width: min(100% - 2rem, 72rem);
    }

    .match-card {
      max-width: none;
    }
  }
</style>
