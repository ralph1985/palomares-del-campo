---
import ExternalLink from '../components/ui/ExternalLink.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import {
  municipalEmailHref,
  municipalInfo,
  municipalInfoReviewedAt,
  municipalPhoneHref,
} from '../data/municipal-info';

const transportPublishedAt = new Date(
  `${municipalInfo.transport.publishedAt}T00:00:00`,
).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={municipalInfo.pageDescription} />
    <title>{municipalInfo.pageTitle} · Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="practical-hero" aria-labelledby="page-title">
        <div class="practical-shell">
          <p class="eyebrow">Para vecinos y visitantes</p>
          <h1 id="page-title">{municipalInfo.pageTitle}</h1>
          <p class="hero-intro">
            Lo esencial para contactar con el Ayuntamiento y llegar a sus canales oficiales sin dar
            vueltas innecesarias.
          </p>
        </div>
      </section>

      <section class="contact-section" aria-labelledby="contact-title">
        <div class="practical-shell contact-grid">
          <div class="section-intro">
            <p class="eyebrow">Contacto municipal</p>
            <h2 id="contact-title">Ayuntamiento y contacto</h2>
            <p>
              Para trámites, avisos y consultas municipales, utiliza los datos de contacto o los
              canales oficiales que aparecen más abajo.
            </p>
          </div>

          <address class="contact-card">
            <p class="contact-name">{municipalInfo.contact.name}</p>
            <p>
              {municipalInfo.contact.address}
              <br />
              {municipalInfo.contact.locality}
            </p>
            <p>{municipalInfo.contact.judicialDistrict}</p>
            <div class="contact-actions">
              <a class="button-link" href={municipalPhoneHref}>
                Llamar al Ayuntamiento
              </a>
              <a class="text-link" href={municipalEmailHref}>
                Escribir por correo electrónico
              </a>
              <ExternalLink class="text-link" href={municipalInfo.contact.mapHref}>
                Abrir ubicación en OpenStreetMap
              </ExternalLink>
            </div>
          </address>
        </div>
      </section>

      <section class="services-section" aria-labelledby="services-title">
        <div class="practical-shell services-grid">
          <div class="section-intro">
            <p class="eyebrow">Trámites y canales</p>
            <h2 id="services-title">Trámites y canales oficiales</h2>
            <p>
              Estos enlaces llevan a los servicios de la sede y del portal municipal. La web
              editorial orienta; los trámites se realizan en sus plataformas oficiales.
            </p>
          </div>

          <nav aria-label="Canales oficiales del Ayuntamiento">
            <ul class="service-list">
              {municipalInfo.officialServices.map((service, index) => (
                <li>
                  <ExternalLink href={service.href}>
                    <span class="service-index">0{index + 1}</span>
                    <span>{service.label}</span>
                    <span class="service-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </ExternalLink>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </section>

      <section class="transport-section" aria-labelledby="transport-title">
        <div class="practical-shell transport-grid">
          <div>
            <p class="eyebrow">Fuente oficial · Publicado el {transportPublishedAt}</p>
            <h2 id="transport-title">{municipalInfo.transport.title}</h2>
          </div>
          <div>
            <p>{municipalInfo.transport.description}</p>
            <div class="transport-routes">
              {municipalInfo.transport.routes.map((route) => (
                <section class="transport-route" aria-labelledby={`route-${route.title}`}>
                  <h3 id={`route-${route.title}`}>{route.title}</h3>
                  <table aria-label={`Horarios ${route.title.replace(' → ', ' a ')}`}>
                    <thead>
                      <tr>
                        <th scope="col">Día</th>
                        <th scope="col">Hora</th>
                      </tr>
                    </thead>
                    <tbody>
                      {route.entries.map((entry) => (
                        <tr>
                          <th scope="row">{entry.day}</th>
                          <td>{entry.time}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </section>
              ))}
            </div>
            <p class="transport-note">
              Horarios publicados en el bando citado; comprueba posibles cambios antes de viajar.
            </p>
            <ExternalLink class="source-link" href={municipalInfo.transport.source.href}>
              Ver bando original <span aria-hidden="true">↗</span>
            </ExternalLink>
          </div>
        </div>
      </section>

      <section class="review-section" aria-label="Revisión de la información">
        <div class="practical-shell review-inner">
          <p>
            Fuentes visibles en cada bloque · Revisado el
            {` ${new Date(`${municipalInfoReviewedAt}T00:00:00`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}`}
          </p>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    min-width: 320px;
    margin: 0;
    color: #19342d;
    background: #f4f1e9;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }

  .practical-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .practical-hero {
    padding: clamp(5rem, 12vw, 9rem) 0 clamp(4rem, 9vw, 7rem);
    background: #d8e6d6;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: #a05c32;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  h1 {
    max-width: 11ch;
    font-size: clamp(3.3rem, 8vw, 7.5rem);
  }

  h2 {
    max-width: 13ch;
    font-size: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-intro,
  .section-intro > p:not(.eyebrow),
  .transport-grid p:not(.eyebrow) {
    max-width: 35rem;
    margin: 2rem 0 0;
    color: #527066;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .contact-section,
  .services-section {
    padding: clamp(4.5rem, 10vw, 8rem) 0;
  }

  .contact-grid,
  .services-grid,
  .transport-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .contact-card {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: clamp(1.75rem, 5vw, 3rem);
    border-radius: 1.5rem;
    color: #eff5ed;
    background: #2f6652;
    font-style: normal;
    line-height: 1.6;
  }

  .contact-card p {
    margin: 0;
  }

  .contact-name {
    color: #fff;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.05;
  }

  .contact-actions {
    display: grid;
    justify-items: start;
    gap: 0.85rem;
    margin-top: 1.2rem;
  }

  .button-link,
  .text-link,
  .source-link {
    color: inherit;
    font-weight: 750;
    text-underline-offset: 0.25em;
  }

  .button-link {
    padding: 0.85rem 1.1rem;
    border-radius: 999px;
    color: #19342d;
    background: #e5b77e;
    text-decoration: none;
  }

  .contact-card .text-link {
    color: #e5f0df;
  }

  .services-section {
    color: #19342d;
    background: #e9eee7;
  }

  .service-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(25 52 45 / 22%);
    list-style: none;
  }

  .service-list li {
    border-bottom: 1px solid rgb(25 52 45 / 22%);
  }

  .service-list a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.1rem 0;
    color: #19342d;
    font-weight: 700;
    text-decoration: none;
  }

  .service-list a:focus-visible,
  .service-list a:hover {
    color: #a05c32;
  }

  .service-index {
    color: #a05c32;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .service-arrow {
    color: #a05c32;
  }

  .transport-section {
    padding: clamp(4.5rem, 10vw, 8rem) 0;
    color: #eff5ed;
    background: #19342d;
  }

  .transport-section .eyebrow,
  .transport-section .source-link {
    color: #e5b77e;
  }

  .transport-section h2 {
    color: #fff;
  }

  .transport-section p:not(.eyebrow) {
    margin-top: 0;
    color: #c3d9c7;
  }

  .transport-routes {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .transport-route {
    padding: 1rem 1.15rem;
    border: 1px solid rgb(239 245 237 / 18%);
    border-radius: 1rem;
    background: rgb(255 255 255 / 4%);
  }

  .transport-route h3 {
    margin: 0 0 0.75rem;
    color: #fff;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .transport-route table {
    width: 100%;
    border-collapse: collapse;
    color: #eff5ed;
    font-size: 0.95rem;
  }

  .transport-route th,
  .transport-route td {
    padding: 0.55rem 0;
    border-top: 1px solid rgb(239 245 237 / 14%);
    text-align: left;
  }

  .transport-route thead th {
    color: #e5b77e;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .transport-route tbody th {
    font-weight: 500;
  }

  .transport-route td {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .transport-note {
    margin-bottom: 1rem !important;
    color: #b7d0bc !important;
    font-size: 0.85rem;
  }

  .review-section {
    color: #527066;
    background: #f4f1e9;
  }

  .review-inner {
    padding: 1.4rem 0;
  }

  .review-inner p {
    margin: 0;
    font-size: 0.8rem;
  }

  @media (max-width: 50rem) {
    .contact-grid,
    .services-grid,
    .transport-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 38rem) {
    .practical-shell {
      width: min(100% - 2rem, 72rem);
    }

    .service-list a {
      grid-template-columns: 2rem 1fr auto;
      gap: 0.65rem;
    }
  }
</style>
