---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialHero from '../../components/hero/EditorialHero.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import { services, servicesReviewedAt, serviceCategoryLabels } from '../../data/services';

const categories = [...new Set(services.map(({ category }) => category))];
---

<BaseLayout
  title="Servicios del pueblo | Palomares del Campo"
  description="Directorio revisable de comercios, hostelería, servicios e instalaciones de Palomares del Campo, con fuentes y estado de validación."
  canonicalPath="/servicios-del-pueblo/"
  schema="website"
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Servicios del pueblo', path: '/servicios-del-pueblo/' },
  ]}
>
  <main>
    <EditorialHero variant="paper" labelledBy="services-title" titleWidth="wide">
      <p slot="eyebrow" class="eyebrow">
        Guía local · Revisión {servicesReviewedAt}
      </p>
      <h1 slot="title" id="services-title">
        Servicios del pueblo
      </h1>
      <p slot="summary" class="hero-intro">
        Comercios, hostelería e instalaciones con la fuente y el grado de verificación de cada
        ficha. Los nombres candidatos no confirman por sí solos que un negocio siga activo. No
        mostramos direcciones, teléfonos ni horarios sin una fuente actual contrastada.
      </p>
      <p slot="notice" class="review-explainer">
        Esta página es una recopilación editorial en revisión; una mención en un catálogo o
        directorio no equivale a confirmación municipal ni garantiza disponibilidad actual. Consulta
        la fuente enlazada antes de desplazarte.
      </p>
    </EditorialHero>

    <section class="services-directory" aria-label="Fichas de servicios locales">
      <div class="services-directory__inner">
        {categories.map((category) => (
          <section class="service-group" aria-labelledby={`category-${category}`}>
            <header class="service-group__heading">
              <p class="eyebrow">Directorio revisable</p>
              <h2 id={`category-${category}`}>{serviceCategoryLabels[category]}</h2>
            </header>
            <div class="service-grid">
              {services
                .filter((service) => service.category === category)
                .map((service) => (
                  <ServiceCard service={service} categoryLabel={serviceCategoryLabels[category]} />
                ))}
            </div>
          </section>
        ))}
        <p class="source-method">
          Revisión de fuentes: {servicesReviewedAt}. Se han consultado el catálogo municipal,
          fuentes institucionales disponibles y referencias públicas identificables. El catálogo
          enumera la piscina, la biblioteca, el Centro de Internet, el Wi-Fi de la Casa de Cultura y
          el Centro Médico, pero no permite confirmar su estado operativo ni ofrece en esta ficha un
          inventario de espacios públicos o un expediente de nuevas instalaciones deportivas. No se
          ha verificado en persona la apertura de establecimientos ni el funcionamiento actual de
          instalaciones.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .review-explainer {
    max-width: 48rem;
    margin: 0;
    padding: 1rem 1.1rem;
    border-left: 3px solid var(--color-clay);
    color: var(--color-ink);
    background: var(--color-surface-soft);
    line-height: 1.6;
  }
  .services-directory {
    padding: var(--spacing-section-y) 0;
    background: var(--color-paper);
  }
  .services-directory__inner {
    display: grid;
    gap: clamp(3rem, 7vw, 5.5rem);
    width: min(100% - 2.5rem, 72rem);
    margin-inline: auto;
  }
  .service-group {
    display: grid;
    gap: 1.5rem;
  }
  .service-group__heading {
    display: grid;
    gap: 0.4rem;
  }
  .service-group__heading .eyebrow {
    margin: 0;
    color: var(--color-clay-text);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .service-group__heading h2 {
    margin: 0;
    color: var(--color-ink);
    font: 500 clamp(2.4rem, 5vw, 3.5rem)/1 var(--font-serif);
    letter-spacing: -0.06em;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }
  .source-method {
    max-width: 55rem;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--font-size-small);
    line-height: 1.6;
  }
  @media (max-width: 38rem) {
    .services-directory__inner {
      width: min(100% - 2rem, 72rem);
    }
  }
</style>
