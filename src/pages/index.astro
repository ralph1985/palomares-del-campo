---
import ActionLink from '../components/ui/ActionLink.astro';
import EditorialHero from '../components/hero/EditorialHero.astro';
import HomeAudienceCards from '../components/home/HomeAudienceCards.astro';
import HomeEditorialGuide from '../components/home/HomeEditorialGuide.astro';
import NewsSection from '../components/NewsSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PUBLIC_BALL_GAME_ENABLED } from 'astro:env/client';
---

<BaseLayout
  title="Palomares del Campo"
  description="Consulta servicios municipales, agenda y bandos, y descubre la historia, las rutas y los alojamientos de Palomares del Campo."
  schema="website"
>
  <main id="inicio">
    <EditorialHero id="proyecto" labelledBy="intro-title" variant="sage-display">
      <p slot="eyebrow" class="eyebrow">
        Palomares del Campo · Cuenca
      </p>
      <h1 slot="title" id="intro-title">
        Palomares, en un mismo lugar.
      </h1>
      <p slot="summary" class="hero-intro">
        Consulta servicios municipales, agenda y bandos; descubre la historia, las rutas y los
        alojamientos de Palomares del Campo.
      </p>
      <div slot="actions" class="home-actions">
        <ActionLink variant="solid" href="/agenda/">
          Consultar la agenda <span aria-hidden="true">→</span>
        </ActionLink>
        <ActionLink variant="underline" href="/informacion-practica/">
          Servicios municipales <span aria-hidden="true">→</span>
        </ActionLink>
      </div>
      {PUBLIC_BALL_GAME_ENABLED && (
        <ActionLink slot="actions" variant="underline" href="/juego/">
          Probar el mapa del juego <span aria-hidden="true">→</span>
        </ActionLink>
      )}
    </EditorialHero>

    <HomeAudienceCards />
    <HomeEditorialGuide />
    <NewsSection />
  </main>
</BaseLayout>

<style>
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  @media (max-width: 38rem) {
    .home-actions {
      display: grid;
      justify-items: start;
      gap: 1rem;
    }
  }
</style>
