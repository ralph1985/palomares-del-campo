---
import NewsSection from '../components/NewsSection.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Palomares del Campo: un nuevo espacio digital para el pueblo."
    />
    <title>Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main id="inicio">
      <section class="intro" id="proyecto" aria-labelledby="intro-title">
        <p class="eyebrow">Palomares del Campo · Cuenca</p>
        <h1 id="intro-title">Un nuevo espacio para descubrir el pueblo.</h1>
        <p class="intro-copy">
          Este proyecto está tomando forma. Aquí reuniremos información, lugares e historias de
          Palomares del Campo en una experiencia clara y cercana.
        </p>
        <a class="intro-action" href="/juego/">
          Probar el mapa del juego <span aria-hidden="true">→</span>
        </a>
      </section>

      <NewsSection />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #19342d;
    background: #f4f1e9;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }

  .intro {
    display: grid;
    align-content: center;
    width: min(100% - 2.5rem, 72rem);
    min-height: calc(100vh - 10.5rem);
    margin: 0 auto;
    padding: 6rem 0;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: #a05c32;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    color: #19342d;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3.4rem, 8vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  .intro-copy {
    max-width: 34rem;
    margin: 2rem 0 0;
    color: #527066;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .intro-action {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    margin-top: 2rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid #a05c32;
    color: #a05c32;
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
  }

  .intro-action span {
    font-size: 1.2rem;
    transition: transform 180ms ease;
  }

  .intro-action:hover span,
  .intro-action:focus-visible span {
    transform: translateX(0.25rem);
  }

  .intro-action:focus-visible {
    outline: 3px solid #c68455;
    outline-offset: 5px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .intro-action span {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 38rem) {
    .intro,
    .footer-inner {
      width: min(100% - 2rem, 72rem);
    }

    .intro {
      min-height: calc(100vh - 10.25rem);
      padding: 4rem 0;
    }
  }
</style>
