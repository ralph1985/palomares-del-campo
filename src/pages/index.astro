---
import NewsSection from '../components/NewsSection.astro';
import ConquenseCredit from '../components/layout/ConquenseCredit.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Palomares del Campo: un nuevo espacio digital para el pueblo."
    />
    <title>Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main id="inicio">
      <section class="intro" id="proyecto" aria-labelledby="intro-title">
        <p class="eyebrow">Palomares del Campo · Cuenca</p>
        <h1 id="intro-title">Un nuevo espacio para descubrir el pueblo.</h1>
        <p class="intro-copy">
          Este proyecto está tomando forma. Aquí reuniremos información,
          lugares e historias de Palomares del Campo en una experiencia clara y
          cercana.
        </p>
        <a class="intro-action" href="/juego/">Probar el mapa del juego <span aria-hidden="true">→</span></a>
      </section>

      <NewsSection />
    </main>

    <footer class="site-footer" id="contacto">
      <div class="footer-inner">
        <p>© {currentYear} Palomares del Campo</p>
        <ConquenseCredit />
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #19342d;
    background: #f4f1e9;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  :global(body.menu-is-open) {
    overflow: hidden;
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgb(25 52 45 / 12%);
    background: rgb(244 241 233 / 92%);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header.is-hidden {
    transform: translateY(-105%);
  }

  .header-inner,
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .header-inner {
    min-height: 5.25rem;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border-radius: 0.8rem;
    color: #f4f1e9;
    background: #2f6652;
    font-family: Georgia, serif;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .menu-toggle,
  .menu-close {
    border: 0;
    cursor: pointer;
    font: inherit;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0;
    color: #19342d;
    background: transparent;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .menu-toggle-icon {
    display: grid;
    gap: 0.3rem;
    width: 1.5rem;
  }

  .menu-toggle-icon span {
    display: block;
    height: 2px;
    border-radius: 999px;
    background: #2f6652;
    transition: transform 220ms ease;
  }

  .menu-toggle-icon span:last-child {
    width: 70%;
    justify-self: end;
  }

  .menu-toggle:hover .menu-toggle-icon span:first-child,
  .menu-toggle:focus-visible .menu-toggle-icon span:first-child {
    transform: translateX(-0.2rem);
  }

  .menu-toggle:hover .menu-toggle-icon span:last-child,
  .menu-toggle:focus-visible .menu-toggle-icon span:last-child {
    transform: translateX(0.2rem);
  }

  .menu-toggle:focus-visible,
  .menu-close:focus-visible,
  .side-nav a:focus-visible,
  .brand:focus-visible {
    outline: 3px solid #c68455;
    outline-offset: 5px;
  }

  .menu-backdrop {
    position: fixed;
    z-index: 25;
    inset: 0;
    width: 100%;
    border: 0;
    background: rgb(13 29 25 / 52%);
    cursor: pointer;
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .menu-backdrop:not([hidden]) {
    opacity: 1;
  }

  .side-menu {
    position: fixed;
    z-index: 30;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100%, 31rem);
    overflow-y: auto;
    color: #eff5ed;
    background: #19342d;
    box-shadow: -1.5rem 0 4rem rgb(13 29 25 / 18%);
    transform: translateX(102%);
    transition: transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .side-menu.is-open {
    transform: translateX(0);
  }

  .side-menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 1.5rem clamp(1.5rem, 5vw, 3rem) 2rem;
  }

  .side-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu-kicker,
  .eyebrow {
    margin: 0;
    color: #e5b77e;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .menu-close {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgb(239 245 237 / 22%);
    border-radius: 50%;
    color: #eff5ed;
    background: transparent;
    font-size: 1.8rem;
    font-weight: 300;
    line-height: 1;
  }

  .menu-close:hover,
  .menu-close:focus-visible {
    border-color: #e5b77e;
    color: #e5b77e;
  }

  .side-menu-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding: clamp(4rem, 13vh, 8rem) 0 1rem;
  }

  .side-nav {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side-nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.65rem 0;
    color: #eff5ed;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 6vw, 3.2rem);
    letter-spacing: -0.045em;
    line-height: 1;
    text-decoration: none;
  }

  .side-nav a span {
    color: #8fb49c;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .side-nav a:hover,
  .side-nav a:focus-visible {
    color: #e5b77e;
  }

  .menu-visual {
    position: relative;
    min-height: 15rem;
    overflow: hidden;
    border: 1px solid rgb(239 245 237 / 14%);
    border-radius: 1.5rem;
    background: radial-gradient(circle at 52% 38%, #315f4e 0%, #214538 42%, #142a25 100%);
  }

  #menu-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .menu-visual::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 25%, rgb(13 29 25 / 72%) 100%);
    content: "";
    pointer-events: none;
  }

  .menu-visual-copy {
    position: absolute;
    z-index: 1;
    right: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
  }

  .menu-visual-copy p,
  .menu-visual-copy small {
    display: block;
    margin: 0;
  }

  .menu-visual-copy p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .menu-visual-copy small {
    margin-top: 0.35rem;
    color: #b7d0bc;
    font-size: 0.75rem;
  }

  .visual-pulse {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #e5b77e;
    box-shadow: 0 0 0 0.3rem rgb(229 183 126 / 16%);
  }

  .intro {
    display: grid;
    align-content: center;
    width: min(100% - 2.5rem, 72rem);
    min-height: calc(100vh - 10.5rem);
    margin: 0 auto;
    padding: 6rem 0;
  }

  .eyebrow {
    margin-bottom: 1.25rem;
    color: #a05c32;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    color: #19342d;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.4rem, 8vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  .intro-copy {
    max-width: 34rem;
    margin: 2rem 0 0;
    color: #527066;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .intro-action {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    margin-top: 2rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid #a05c32;
    color: #a05c32;
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
  }

  .intro-action span {
    font-size: 1.2rem;
    transition: transform 180ms ease;
  }

  .intro-action:hover span,
  .intro-action:focus-visible span {
    transform: translateX(0.25rem);
  }

  .intro-action:focus-visible {
    outline: 3px solid #c68455;
    outline-offset: 5px;
  }

  .site-footer {
    color: #dfe9df;
    background: #19342d;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    min-height: 5.25rem;
    gap: 1rem;
    color: #dfe9df;
    font-size: 0.82rem;
  }

  .footer-inner p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .side-menu,
    .menu-backdrop,
    .menu-toggle-icon span,
    .site-header {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 38rem) {
    .header-inner,
    .footer-inner {
      width: min(100% - 2rem, 72rem);
    }

    .header-inner {
      min-height: 5rem;
    }

    .menu-toggle-label {
      display: none;
    }

    .intro {
      width: min(100% - 2rem, 72rem);
      min-height: calc(100vh - 10.25rem);
      padding: 4rem 0;
    }

    .footer-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      min-height: 6.5rem;
      padding: 1rem 0;
    }
  }
</style>
