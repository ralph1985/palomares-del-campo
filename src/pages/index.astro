---
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Palomares del Campo: un nuevo espacio digital para el pueblo."
    />
    <title>Palomares del Campo</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Palomares del Campo, inicio">
          <span class="brand-mark" aria-hidden="true">P</span>
          <span>Palomares del Campo</span>
        </a>

        <nav aria-label="Navegación principal">
          <ul class="nav-list">
            <li><a href="#inicio">Inicio</a></li>
            <li><a href="#proyecto">Proyecto</a></li>
            <li><a href="#contacto">Contacto</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="inicio">
      <section class="intro" id="proyecto" aria-labelledby="intro-title">
        <p class="eyebrow">Palomares del Campo · Cuenca</p>
        <h1 id="intro-title">Un nuevo espacio para descubrir el pueblo.</h1>
        <p class="intro-copy">
          Este proyecto está tomando forma. Aquí reuniremos información,
          lugares e historias de Palomares del Campo en una experiencia clara y
          cercana.
        </p>
      </section>
    </main>

    <footer class="site-footer" id="contacto">
      <div class="footer-inner">
        <p>© {currentYear} Palomares del Campo</p>
        <p>Hecho con Astro y Three.js.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #19342d;
    background: #f4f1e9;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .site-header {
    border-bottom: 1px solid rgb(25 52 45 / 12%);
    background: rgb(244 241 233 / 92%);
  }

  .header-inner,
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .header-inner {
    min-height: 5.25rem;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border-radius: 0.8rem;
    color: #f4f1e9;
    background: #2f6652;
    font-family: Georgia, serif;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .nav-list {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    color: #446057;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .nav-list a:hover,
  .nav-list a:focus-visible {
    color: #19342d;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .intro {
    display: grid;
    align-content: center;
    width: min(100% - 2.5rem, 72rem);
    min-height: calc(100vh - 10.5rem);
    margin: 0 auto;
    padding: 6rem 0;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: #a05c32;
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    color: #19342d;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.4rem, 8vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  .intro-copy {
    max-width: 34rem;
    margin: 2rem 0 0;
    color: #527066;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .site-footer {
    color: #dfe9df;
    background: #19342d;
  }

  .footer-inner {
    min-height: 5.25rem;
    gap: 1rem;
    color: #dfe9df;
    font-size: 0.82rem;
  }

  .footer-inner p {
    margin: 0;
  }

  @media (max-width: 38rem) {
    .header-inner,
    .footer-inner {
      width: min(100% - 2rem, 72rem);
    }

    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      min-height: 7.5rem;
      gap: 1rem;
    }

    .intro {
      width: min(100% - 2rem, 72rem);
      min-height: calc(100vh - 12.75rem);
      padding: 4rem 0;
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      min-height: 6.5rem;
      padding: 1.25rem 0;
    }
  }
</style>
