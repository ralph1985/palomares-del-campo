---
import { getCollection } from 'astro:content';
import BandoCard from '../../components/BandoCard.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';

const posts = (await getCollection('bandos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const categories = [...new Set(posts.map((post) => post.data.category))].sort((a, b) =>
  a.localeCompare(b, 'es'),
);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Bandos y comunicados publicados por el Ayuntamiento de Palomares del Campo."
    />
    <title>Bandos · Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="bandos-hero" aria-labelledby="page-title">
        <div class="bandos-hero-inner">
          <p class="eyebrow">Palomares del Campo · Actualidad</p>
          <h1 id="page-title">Bandos</h1>
          <p>
            Comunicados municipales publicados en el canal de Palomares del Campo Informa, con
            fecha, categoría y enlace a la fuente original.
          </p>
        </div>
      </section>

      <section class="archive" aria-labelledby="archive-title">
        <div class="archive-inner">
          <div class="archive-heading">
            <div>
              <p class="eyebrow">Comunicaciones municipales</p>
              <h2 id="archive-title">Bandos publicados</h2>
            </div>
            <p>
              {posts.length} {posts.length === 1 ? 'bando publicado' : 'bandos publicados'}
            </p>
          </div>

          <form class="filters" data-bando-filters role="search">
            <div class="filter-field">
              <label for="bando-search">Buscar por título</label>
              <input id="bando-search" name="search" type="search" placeholder="Ej. autobús" />
            </div>
            <div class="filter-field">
              <label for="bando-category">Categoría</label>
              <select id="bando-category" name="category">
                <option value="">Todas las categorías</option>
                {categories.map((category) => (
                  <option value={category}>{category}</option>
                ))}
              </select>
            </div>
            <p class="filter-results" data-bando-results aria-live="polite">
              {posts.length} resultados
            </p>
          </form>

          {posts.length > 0 ? (
            <div class="bando-grid">
              {posts.map((post) => (
                <BandoCard post={post} />
              ))}
            </div>
          ) : (
            <p class="empty">Todavía no hay bandos publicados.</p>
          )}
          <p class="empty" data-bando-no-results hidden>
            No hay bandos que coincidan con estos filtros.
          </p>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #19342d;
    background: #f4f1e9;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }

  .bandos-hero {
    padding: clamp(5rem, 13vw, 10rem) 0 clamp(4rem, 9vw, 7rem);
    background: #19342d;
  }

  .bandos-hero-inner,
  .archive-inner {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .bandos-hero-inner {
    color: #eff5ed;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #e5b77e;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  h1 {
    font-size: clamp(4rem, 11vw, 8rem);
  }

  .bandos-hero p:last-child {
    max-width: 36rem;
    margin: 2rem 0 0;
    color: #b7d0bc;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.65;
  }

  .archive {
    padding: clamp(4rem, 9vw, 8rem) 0;
  }

  .archive-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .archive-heading .eyebrow {
    color: #a05c32;
  }

  .archive-heading h2 {
    font-size: clamp(2.25rem, 5vw, 4rem);
  }

  .archive-heading > p {
    margin: 0;
    color: #527066;
    font-size: 0.9rem;
  }

  .filters {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(12rem, 1fr) auto;
    align-items: end;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 1rem;
    border: 1px solid rgb(25 52 45 / 12%);
    border-radius: 1rem;
    background: rgb(255 253 248 / 70%);
  }

  .filter-field {
    display: grid;
    gap: 0.45rem;
  }

  .filter-field label {
    color: #527066;
    font-size: 0.78rem;
    font-weight: 750;
  }

  .filter-field input,
  .filter-field select {
    min-height: 2.75rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgb(25 52 45 / 20%);
    border-radius: 0.55rem;
    color: #19342d;
    background: #fffdf8;
    font: inherit;
  }

  .filter-field input:focus-visible,
  .filter-field select:focus-visible {
    outline: 3px solid rgb(160 92 50 / 28%);
    outline-offset: 2px;
  }

  .filter-results {
    margin: 0 0 0.7rem;
    color: #527066;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .bando-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .empty {
    padding: 2rem;
    border: 1px dashed rgb(25 52 45 / 22%);
    color: #527066;
  }

  @media (max-width: 50rem) {
    .bando-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .bandos-hero-inner,
    .archive-inner {
      width: min(100% - 2rem, 72rem);
    }

    .archive-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .filters {
      grid-template-columns: 1fr;
    }

    .filter-results {
      margin-bottom: 0;
    }
  }
</style>

<script>
  const filters = document.querySelector<HTMLFormElement>('[data-bando-filters]');

  if (filters) {
    const search = filters.querySelector<HTMLInputElement>('#bando-search');
    const category = filters.querySelector<HTMLSelectElement>('#bando-category');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-bando-card]'));
    const results = filters.querySelector<HTMLElement>('[data-bando-results]');
    const noResults = document.querySelector<HTMLElement>('[data-bando-no-results]');

    const updateResults = () => {
      const query = search?.value.trim().toLocaleLowerCase('es-ES') ?? '';
      const selectedCategory = category?.value ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesQuery = !query || (card.dataset.bandoTitle ?? '').includes(query);
        const matchesCategory =
          !selectedCategory || card.dataset.bandoCategory === selectedCategory;
        const visible = matchesQuery && matchesCategory;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (results) {
        results.textContent = `${visibleCount} ${visibleCount === 1 ? 'resultado' : 'resultados'}`;
      }
      if (noResults) {
        noResults.hidden = visibleCount !== 0;
      }
    };

    search?.addEventListener('input', updateResults);
    category?.addEventListener('change', updateResults);
  }
</script>
