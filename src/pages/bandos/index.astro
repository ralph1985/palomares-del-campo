---
import { getCollection } from 'astro:content';
import BandoCard from '../../components/BandoCard.astro';
import CollectionArchive from '../../components/CollectionArchive.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import '../../styles/global.css';

const posts = (await getCollection('bandos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const categories = [...new Set(posts.map((post) => post.data.category))].sort((a, b) =>
  a.localeCompare(b, 'es'),
);
const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))].sort((a, b) => b - a);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Bandos y comunicados publicados por el Ayuntamiento de Palomares del Campo."
    />
    <title>Bandos · Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="bandos-hero" aria-labelledby="page-title">
        <div class="bandos-hero-inner">
          <p class="eyebrow">Palomares del Campo · Actualidad</p>
          <h1 id="page-title">Bandos</h1>
          <p>
            Comunicados municipales publicados en el canal de Palomares del Campo Informa, con
            fecha, categoría y enlace a la fuente original.
          </p>
        </div>
      </section>

      <CollectionArchive
        scope="bando"
        headingId="archive-title"
        eyebrow="Comunicaciones municipales"
        title="Bandos publicados"
        total={posts.length}
        itemSingular="bando publicado"
        itemPlural="bandos publicados"
        emptyMessage="Todavía no hay bandos publicados."
        searchLabel="Buscar en bandos"
        inputId="bando-search"
        placeholder="Ej. autobús, piscina o dentista"
        action="/bandos/"
        categories={categories}
        years={years}
      >
        {posts.map((post) => (
          <BandoCard post={post} />
        ))}
      </CollectionArchive>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .bandos-hero {
    padding: clamp(5rem, 13vw, 10rem) 0 clamp(4rem, 9vw, 7rem);
    background: var(--color-ink);
  }
  .bandos-hero-inner {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
    color: var(--color-surface-soft);
  }
  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-ochre);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 11vw, 8rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }
  .bandos-hero p:last-child {
    max-width: 36rem;
    margin: 2rem 0 0;
    color: var(--color-sage-light);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.65;
  }
  @media (max-width: 38rem) {
    .bandos-hero-inner {
      width: min(100% - 2rem, 72rem);
    }
  }
</style>
