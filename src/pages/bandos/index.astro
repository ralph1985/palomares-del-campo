---
import { getCollection } from 'astro:content';
import BandoCard from '../../components/BandoCard.astro';
import CollectionArchive from '../../components/CollectionArchive.astro';
import EditorialHero from '../../components/hero/EditorialHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('bandos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const categories = [...new Set(posts.map((post) => post.data.category))].sort((a, b) =>
  a.localeCompare(b, 'es'),
);
const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))].sort((a, b) => b - a);
---

<BaseLayout
  title="Bandos · Palomares del Campo"
  description="Bandos y comunicados publicados por el Ayuntamiento de Palomares del Campo."
>
  <main>
    <EditorialHero labelledBy="page-title" variant="paper">
      <p slot="eyebrow" class="eyebrow">
        Palomares del Campo · Actualidad
      </p>
      <h1 slot="title" id="page-title">
        Bandos
      </h1>
      <p slot="summary" class="hero-intro">
        Comunicados municipales publicados en el canal de Palomares del Campo Informa, con fecha,
        categoría y enlace a la fuente original.
      </p>
    </EditorialHero>

    <CollectionArchive
      scope="bando"
      headingId="archive-title"
      eyebrow="Comunicaciones municipales"
      title="Bandos publicados"
      total={posts.length}
      itemSingular="bando publicado"
      itemPlural="bandos publicados"
      emptyMessage="Todavía no hay bandos publicados."
      searchLabel="Buscar en bandos"
      inputId="bando-search"
      placeholder="Ej. autobús, piscina o dentista"
      action="/bandos/"
      categories={categories}
      years={years}
    >
      {posts.map((post) => (
        <BandoCard post={post} />
      ))}
    </CollectionArchive>
  </main>
</BaseLayout>
