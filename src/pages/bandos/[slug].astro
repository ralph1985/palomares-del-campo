---
import { getImage, inferRemoteSize } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { getResponsiveImageWidths, optimizeRemoteImage } from '../../images';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('bandos');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const {
  title,
  description,
  author,
  authorType,
  date,
  category,
  sourceName,
  sourceUrl,
  attachments,
} = post.data;
const imageAttachment = attachments.find((attachment) => attachment.type === 'image');
const renderedAttachments = await Promise.all(
  attachments.map(async (attachment) => {
    if (attachment.type !== 'image') {
      return { attachment, imageSource: null, optimizedImage: null };
    }

    const result = await optimizeRemoteImage(
      attachment.url,
      () =>
        import.meta.env.PROD
          ? inferRemoteSize(attachment.url)
          : Promise.resolve({ width: 864, height: 576 }),
      (dimensions) =>
        getImage({
          src: attachment.url,
          width: dimensions.width,
          height: dimensions.height,
          widths: getResponsiveImageWidths(dimensions.width, [320, 640, 864]),
          sizes: '(max-width: 54rem) calc(100vw - 2rem), 52rem',
          format: 'webp',
          quality: 85,
        }),
      (error) =>
        console.warn(
          `Could not optimize a bando image; preserving its source URL: ${attachment.url}`,
          error,
        ),
    );

    return {
      attachment,
      imageSource: result.source,
      optimizedImage: result.transformed,
    };
  }),
);
const socialImageAttachment = renderedAttachments.find(
  ({ attachment }) => attachment.type === 'image',
);
const socialImage =
  socialImageAttachment?.optimizedImage?.src ?? socialImageAttachment?.imageSource ?? undefined;
const formattedDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<BaseLayout
  title={`${title} · Bandos · Palomares del Campo`}
  description={description}
  canonicalPath={`/bandos/${post.id}/`}
  type="article"
  schema="article"
  article={{
    headline: title,
    author,
    authorType,
    datePublished: date,
    sourceUrl,
    ...(category === undefined ? {} : { section: category }),
  }}
  {...(socialImage === undefined ? {} : { socialImage })}
  {...(imageAttachment?.label === undefined ? {} : { socialImageAlt: imageAttachment.label })}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Bandos', path: '/bandos/' },
    { name: title, path: `/bandos/${post.id}/` },
  ]}
>
  <main class="article-shell">
    <article>
      <header class="article-header">
        <p class="eyebrow">{category}</p>
        <h1>{title}</h1>
        <div class="article-meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>
      </header>

      <div class="article-content">
        <Content />
      </div>

      {renderedAttachments.length > 0 && (
        <section class="article-attachments" aria-labelledby="attachments-title">
          <h2 id="attachments-title">Recursos del comunicado</h2>
          <div class="attachment-list">
            {renderedAttachments.map(({ attachment, imageSource, optimizedImage }) =>
              attachment.type === 'image' ? (
                <figure class="attachment-image">
                  <img
                    src={optimizedImage?.src ?? imageSource ?? attachment.url}
                    srcset={optimizedImage?.srcSet.attribute}
                    sizes="(max-width: 54rem) calc(100vw - 2rem), 52rem"
                    width={optimizedImage?.options.width}
                    height={optimizedImage?.options.height}
                    alt={attachment.alt ?? attachment.label}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{attachment.label}</figcaption>
                </figure>
              ) : (
                <div class="attachment-link">
                  <span>{attachment.type === 'video' ? 'Vídeo' : 'Documento'}</span>
                  <ExternalLink href={attachment.url}>{attachment.label} ↗</ExternalLink>
                </div>
              ),
            )}
          </div>
        </section>
      )}

      <footer class="article-source">
        <span>Fuente original:</span>
        <ExternalLink href={sourceUrl}>{sourceName} ↗</ExternalLink>
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  :global(html) {
    overflow-x: hidden;
  }

  .article-shell {
    width: min(100% - 2.5rem, 54rem);
    margin: 0 auto;
    padding: var(--spacing-section-y) 0;
  }

  .article-source a {
    color: var(--color-forest);
    font-size: 0.85rem;
    font-weight: var(--font-weight-strong);
    text-decoration: none;
  }

  .article-source a:hover,
  .article-source a:focus-visible {
    color: var(--color-clay);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .article-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgb(25 52 45 / 16%);
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-clay);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--font-size-page-title);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--color-clay);
    font-size: 0.78rem;
    font-weight: var(--font-weight-strong);
    text-transform: uppercase;
  }

  .article-content {
    padding: 3rem 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .article-content :global(p) {
    margin: 0 0 1.5rem;
    overflow-wrap: anywhere;
  }

  .article-content :global(a) {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .article-attachments {
    padding: 2rem 0 2.5rem;
    border-top: 1px solid rgb(25 52 45 / 16%);
  }

  .article-attachments h2 {
    margin: 0 0 1.25rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .attachment-list {
    display: grid;
    gap: 1rem;
  }

  .attachment-image {
    margin: 0;
  }

  .attachment-image img {
    display: block;
    width: 100%;
    max-height: 42rem;
    border: 1px solid rgb(25 52 45 / 16%);
    border-radius: 0.35rem;
    object-fit: contain;
    background: var(--color-surface);
  }

  .attachment-image figcaption {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }

  .attachment-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem;
    padding: 0.9rem 1rem;
    border: 1px solid rgb(25 52 45 / 16%);
    border-radius: 0.35rem;
    background: rgb(255 253 248 / 72%);
    font-family: var(--font-sans);
  }

  .attachment-link > span {
    color: var(--color-clay);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .attachment-link a {
    min-width: 0;
    color: var(--color-forest);
    font-size: 0.9rem;
    font-weight: var(--font-weight-strong);
    overflow-wrap: anywhere;
  }

  .article-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(25 52 45 / 16%);
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 38rem) {
    .article-shell {
      width: min(100% - 2rem, 72rem);
    }
  }
</style>
