---
import { getCollection, render } from 'astro:content';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';

export async function getStaticPaths() {
  const posts = await getCollection('bandos');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, author, date, category, sourceName, sourceUrl } = post.data;
const formattedDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Bandos · Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main class="article-shell">
      <a class="back-link" href="/bandos/">
        ← Volver a bandos
      </a>
      <article>
        <header class="article-header">
          <p class="eyebrow">{category}</p>
          <h1>{title}</h1>
          <div class="article-meta">
            <span>{author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={date.toISOString()}>{formattedDate}</time>
          </div>
        </header>

        <div class="article-content">
          <Content />
        </div>

        <footer class="article-source">
          <span>Fuente original:</span>
          <ExternalLink href={sourceUrl}>{sourceName} ↗</ExternalLink>
        </footer>
      </article>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    overflow-x: hidden;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #19342d;
    background: #f4f1e9;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }

  .article-shell {
    width: min(100% - 2.5rem, 54rem);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 7rem) 0;
  }

  .back-link,
  .article-source a {
    color: #2f6652;
    font-size: 0.85rem;
    font-weight: 750;
    text-decoration: none;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 3rem;
  }

  .back-link:hover,
  .back-link:focus-visible,
  .article-source a:hover,
  .article-source a:focus-visible {
    color: #a05c32;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .article-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgb(25 52 45 / 16%);
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: #a05c32;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.8rem, 7vw, 5.7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: #a05c32;
    font-size: 0.78rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .article-content {
    padding: 3rem 0;
    color: #294a40;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .article-content :global(p) {
    margin: 0 0 1.5rem;
    overflow-wrap: anywhere;
  }

  .article-content :global(a) {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .article-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(25 52 45 / 16%);
    color: #6e8b7c;
    font-size: 0.85rem;
  }

  @media (max-width: 38rem) {
    .article-shell {
      width: min(100% - 2rem, 72rem);
    }
  }
</style>
