---
import ActionLink from '../../components/ui/ActionLink.astro';
import EditorialHero from '../../components/hero/EditorialHero.astro';
import WikilocEmbed from '../../components/routes/WikilocEmbed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUBLIC_BALL_GAME_ENABLED } from 'astro:env/client';
import { localRoutes } from '../../data/routes';
---

<BaseLayout
  title="Rutas del pueblo · Palomares del Campo"
  description="Ruta publicada en Wikiloc por Joaquin Alcarria. Fuente externa, sin verificación municipal sobre el terreno; el mapa solo se carga cuando lo solicita el visitante."
>
  <main>
    <EditorialHero labelledBy="page-title" variant="paper">
      <p slot="eyebrow" class="eyebrow">
        Palomares del Campo · Visita
      </p>
      <h1 slot="title" id="page-title">
        Rutas del pueblo
      </h1>
      <p slot="summary" class="hero-intro">
        Consulta una ruta publicada en Wikiloc por su autor original. El mapa solo se carga si lo
        solicitas; la ficha de Wikiloc es la fuente para sus detalles y cambios.
      </p>
    </EditorialHero>

    <section class="routes-section" aria-labelledby="routes-title">
      <div class="routes-shell">
        <div class="routes-heading">
          <div>
            <p class="eyebrow">Fuente externa · Wikiloc</p>
            <h2 id="routes-title">Consulta la ficha original antes de salir.</h2>
          </div>
          <p>
            El Ayuntamiento no presenta este recorrido como ruta municipal ni lo ha verificado sobre
            el terreno. Comprueba la información y las condiciones locales en la publicación
            original.
          </p>
        </div>

        <div class="route-list">
          {localRoutes.map((route) => (
            <article class="route-card">
              <header class="route-card-header">
                <p class="route-status">{route.statusLabel}</p>
                <h2>{route.title}</h2>
                <p class="route-summary">{route.summary}</p>
              </header>

              <WikilocEmbed
                slug={route.slug}
                title={route.title}
                author={route.author}
                sourceUrl={route.sourceUrl}
                embedUrl={route.embedUrl}
              />

              <div class="route-links">
                {PUBLIC_BALL_GAME_ENABLED && (
                  <ActionLink class="route-game-link" variant="underline" href="/juego/">
                    Probar La bola <span aria-hidden="true">→</span>
                  </ActionLink>
                )}
              </div>
              <p class="route-review">
                La web municipal no ha comprobado el acceso, la seguridad ni el estado actual del
                recorrido. La atribución y el mapa proceden de la ficha enlazada de Wikiloc.
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="routes-note" aria-label="Información sobre la fuente de la ruta">
      <div class="routes-shell">
        <p>
          El mapa es contenido de un proveedor externo y no se solicita al abrir esta página. Puedes
          consultar la ficha original directamente en Wikiloc sin cargar el mapa incrustado.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .routes-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 1.2rem;
    color: var(--color-clay-text);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .routes-section {
    padding: var(--spacing-section-y) 0;
    background: var(--color-sage);
  }

  .routes-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-bottom: 3rem;
  }

  .routes-heading h2 {
    max-width: 14ch;
    font-size: var(--font-size-section-heading);
  }

  .routes-heading > p {
    max-width: 35rem;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .route-list {
    display: grid;
    gap: 1rem;
  }

  .route-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    min-width: 0;
    padding: clamp(1.5rem, 5vw, 3rem);
    border-radius: 1.5rem;
    background: var(--color-paper);
  }

  .route-card-header {
    display: grid;
    gap: 1rem;
  }

  .route-status {
    width: fit-content;
    margin: 0;
    padding: 0.45rem 0.65rem;
    border-radius: 999px;
    color: var(--color-ink);
    background: var(--color-ochre);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .route-card-header h2 {
    max-width: 26ch;
    font-size: var(--font-size-section-heading);
  }

  .route-summary {
    max-width: 45rem;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .route-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
  }

  .route-review {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .routes-note {
    padding: 1.5rem 0;
    color: var(--color-muted);
    background: var(--color-paper);
  }

  .routes-note p {
    max-width: 48rem;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 50rem) {
    .routes-heading {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 38rem) {
    .routes-shell {
      width: min(100% - 2rem, 72rem);
    }
  }
</style>
