---
import CurrentAffairsEmptyState from '../../components/current-affairs/CurrentAffairsEmptyState.astro';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import { agendaItems } from '../../data/current-affairs';
import '../../styles/global.css';

const hasAgenda = agendaItems.length > 0;
const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Agenda de actividades y eventos publicados para Palomares del Campo."
    />
    <title>Agenda · Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      {hasAgenda ? (
        <section class="agenda-section" aria-labelledby="agenda-title">
          <div class="agenda-shell">
            <p class="eyebrow">Actualidad · Agenda</p>
            <h1 id="agenda-title">Agenda</h1>
            <div class="agenda-list">
              {agendaItems.map((item) => (
                <article class="agenda-card">
                  <p class="agenda-date">
                    {formatDate(item.startDate)}
                    {item.endDate ? ` — ${formatDate(item.endDate)}` : ''}
                  </p>
                  <h2>{item.title}</h2>
                  <p class="agenda-meta">
                    {item.category} · {item.location}
                  </p>
                  <p>{item.summary}</p>
                  <ExternalLink href={item.source.href}>
                    {item.source.label} <span aria-hidden="true">↗</span>
                  </ExternalLink>
                </article>
              ))}
            </div>
          </div>
        </section>
      ) : (
        <CurrentAffairsEmptyState
          section="agenda"
          eyebrow="Actualidad · Agenda"
          title="Agenda"
          description="Aquí reuniremos actividades, encuentros y fechas públicas cuando estén confirmadas y tengan una fuente visible."
          emptyMessage="No hay actividades publicadas todavía."
        />
      )}
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .agenda-section {
    min-height: calc(100vh - 10.5rem);
    padding: clamp(5rem, 12vw, 9rem) 0;
    background: #d8e6d6;
  }

  .agenda-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 1.2rem;
    color: #a05c32;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  h1 {
    font-size: clamp(4rem, 12vw, 9rem);
  }

  .agenda-list {
    display: grid;
    gap: 1rem;
    margin-top: 4rem;
  }

  .agenda-card {
    display: grid;
    gap: 0.8rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.25rem;
    background: #f4f1e9;
  }

  .agenda-card h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .agenda-card p {
    max-width: 42rem;
    margin: 0;
    color: #527066;
    line-height: 1.6;
  }

  .agenda-card .agenda-date,
  .agenda-card .agenda-meta {
    color: #a05c32;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .agenda-card a {
    width: fit-content;
    color: #19342d;
    font-weight: 750;
    text-underline-offset: 0.25em;
  }
</style>
