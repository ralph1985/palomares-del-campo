---
import AgendaFilters from '../../components/current-affairs/AgendaFilters.astro';
import AgendaItemCard from '../../components/current-affairs/AgendaItemCard.astro';
import CurrentAffairsEmptyState from '../../components/current-affairs/CurrentAffairsEmptyState.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { agendaItems } from '../../data/current-affairs';
import { getDateInTimeZone, splitAgendaItems } from '../../data/agenda-utils';

const today = getDateInTimeZone(new Date(), 'Europe/Madrid');
const sections = splitAgendaItems(agendaItems, today);
const hasAgenda = agendaItems.length > 0;
const categories = [...new Set(agendaItems.map((item) => item.category))].sort((a, b) =>
  a.localeCompare(b, 'es'),
);
const years = [...new Set(agendaItems.map((item) => item.startDate.slice(0, 4)))].sort().reverse();
---

<BaseLayout
  title="Agenda · Palomares del Campo"
  description="Actividades, servicios públicos y plazos municipales con su fuente oficial."
>
  <main>
    {hasAgenda ? (
      <section class="agenda-section" aria-labelledby="agenda-title" data-agenda>
        <div class="agenda-shell">
          <p class="eyebrow">Actualidad · Agenda</p>
          <h1 id="agenda-title">Agenda</h1>
          <p class="agenda-intro">
            Actividades, servicios y plazos públicos con fechas confirmadas y enlace a su fuente.
          </p>

          <AgendaFilters categories={categories} years={years} />
          <p class="agenda-results" role="status" aria-live="polite" data-agenda-results></p>

          <section
            class="agenda-group"
            aria-labelledby="upcoming-title"
            data-agenda-section="upcoming"
          >
            <h2 id="upcoming-title">Próximas fechas</h2>
            <p
              class="empty-upcoming"
              data-agenda-empty-upcoming
              hidden={sections.upcoming.length > 0}
            >
              No hay próximas actividades ni plazos confirmados.
            </p>
            <div class="agenda-list" data-agenda-list="upcoming">
              {sections.upcoming.map((item) => (
                <AgendaItemCard item={item} />
              ))}
            </div>
            <nav
              class="agenda-pagination"
              aria-label="Páginas de próximas fechas"
              data-pagination
              hidden
            >
              <button type="button" data-page-previous>
                Anterior
              </button>
              <span data-page-label></span>
              <button type="button" data-page-next>
                Siguiente
              </button>
            </nav>
          </section>

          <details
            class="agenda-archive"
            data-agenda-section="past"
            hidden={sections.past.length === 0}
          >
            <summary>
              Fechas pasadas{' '}
              <span class="archive-count" data-agenda-count="past">
                {sections.past.length}
              </span>
            </summary>
            <div class="agenda-list" data-agenda-list="past">
              {sections.past.map((item) => (
                <AgendaItemCard item={item} />
              ))}
            </div>
            <nav
              class="agenda-pagination"
              aria-label="Páginas de fechas pasadas"
              data-pagination
              hidden
            >
              <button type="button" data-page-previous>
                Anterior
              </button>
              <span data-page-label></span>
              <button type="button" data-page-next>
                Siguiente
              </button>
            </nav>
          </details>

          <details
            class="agenda-archive"
            data-agenda-section="cancelled"
            hidden={sections.cancelled.length === 0}
          >
            <summary>
              Actividades canceladas{' '}
              <span class="archive-count" data-agenda-count="cancelled">
                {sections.cancelled.length}
              </span>
            </summary>
            <div class="agenda-list" data-agenda-list="cancelled">
              {sections.cancelled.map((item) => (
                <AgendaItemCard item={item} />
              ))}
            </div>
            <nav
              class="agenda-pagination"
              aria-label="Páginas de actividades canceladas"
              data-pagination
              hidden
            >
              <button type="button" data-page-previous>
                Anterior
              </button>
              <span data-page-label></span>
              <button type="button" data-page-next>
                Siguiente
              </button>
            </nav>
          </details>
        </div>
      </section>
    ) : (
      <CurrentAffairsEmptyState
        section="agenda"
        eyebrow="Actualidad · Agenda"
        title="Agenda"
        description="Aquí reuniremos actividades, servicios públicos y plazos cuando estén confirmados y tengan una fuente visible."
        emptyMessage="No hay fechas públicas confirmadas todavía."
      />
    )}
  </main>
</BaseLayout>

<script>
  import '../../scripts/agenda';
</script>

<style>
  .agenda-section {
    min-height: min(36rem, calc(100vh - 5.25rem));
    padding: var(--spacing-section-y) 0;
    background: var(--color-sage);
  }

  .agenda-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 1.2rem;
    color: var(--color-clay);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  h1 {
    font-size: var(--font-size-page-title);
    line-height: 0.95;
  }

  .agenda-intro {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
  }

  .agenda-group {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .agenda-group h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.05;
  }

  .agenda-pagination button {
    min-height: 2.9rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-forest);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-weight: var(--font-weight-strong);
    cursor: pointer;
  }

  .agenda-pagination button:not(:disabled):hover {
    background: var(--color-forest);
    color: var(--color-surface);
  }

  .agenda-results {
    min-height: 1.5em;
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }

  .agenda-list {
    display: grid;
    gap: 1rem;
  }

  .agenda-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .agenda-pagination span {
    color: var(--color-muted);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-strong);
  }

  .agenda-pagination button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .agenda-archive {
    margin-top: 1.5rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    border-radius: 1.2rem;
    background: color-mix(in srgb, var(--color-paper) 52%, transparent);
  }

  .agenda-archive summary {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    font-weight: var(--font-weight-strong);
    text-underline-offset: 0.25em;
  }

  .agenda-archive[open] summary {
    margin-bottom: 1.25rem;
  }

  .archive-count {
    display: inline-grid;
    min-width: 1.65rem;
    min-height: 1.65rem;
    place-items: center;
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 0.8rem;
  }

  .empty-upcoming {
    margin: 0;
    color: var(--color-muted);
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 34rem) {
    .agenda-shell {
      width: min(100% - 1.5rem, 72rem);
    }

    .agenda-pagination {
      gap: 0.55rem;
    }

    .agenda-pagination button {
      padding-inline: 0.75rem;
    }
  }

  .agenda-pagination :focus-visible {
    outline: 3px solid var(--color-clay);
    outline-offset: 3px;
  }

  [hidden] {
    display: none !important;
  }
</style>
