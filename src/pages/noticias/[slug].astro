---
import { getCollection, render } from 'astro:content';
import ConquenseCredit from '../../components/layout/ConquenseCredit.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('noticias');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, author, date, sourceName, sourceUrl, category } =
  post.data;
const formattedDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main class="article-shell">
      <a class="back-link" href="/noticias">← Volver a noticias</a>
      <article>
        <header class="article-header">
          <p class="eyebrow">{category ?? 'Actualidad'}</p>
          <h1>{title}</h1>
          <p class="article-description">{description}</p>
          <div class="article-meta">
            <span>{author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={date.toISOString()}>{formattedDate}</time>
          </div>
        </header>

        <div class="article-content">
          <Content />
        </div>

        <footer class="article-source">
          <span>Fuente original:</span>
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer">{sourceName} ↗</a>
        </footer>
      </article>
    </main>

    <footer class="page-footer">
      <div class="page-footer-inner">
        <p>© {new Date().getFullYear()} Palomares del Campo</p>
        <a href="/">Inicio</a>
        <ConquenseCredit />
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #19342d;
    background: #f4f1e9;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .page-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgb(25 52 45 / 12%);
    background: rgb(244 241 233 / 92%);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .page-header.is-hidden {
    transform: translateY(-105%);
  }

  .page-header-inner,
  .page-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2.5rem, 72rem);
    min-height: 5.25rem;
    margin: 0 auto;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #19342d;
    font-size: 0.95rem;
    font-weight: 750;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border-radius: 0.8rem;
    color: #f4f1e9;
    background: #2f6652;
    font-family: Georgia, serif;
    font-size: 1.3rem;
  }

  .home-link,
  .back-link,
  .article-source a,
  .page-footer a {
    color: #2f6652;
    font-size: 0.85rem;
    font-weight: 750;
    text-decoration: none;
  }

  .home-link:hover,
  .home-link:focus-visible,
  .back-link:hover,
  .back-link:focus-visible,
  .article-source a:hover,
  .article-source a:focus-visible,
  .page-footer a:hover,
  .page-footer a:focus-visible,
  .brand:focus-visible {
    color: #a05c32;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .article-shell {
    width: min(100% - 2.5rem, 54rem);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 7rem) 0;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 3rem;
  }

  .article-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgb(25 52 45 / 16%);
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: #a05c32;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.8rem, 7vw, 5.7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .article-description {
    max-width: 42rem;
    margin: 2rem 0 1.5rem;
    color: #527066;
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: #a05c32;
    font-size: 0.78rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .article-content {
    padding: 3rem 0;
    color: #294a40;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .article-content :global(p) {
    margin: 0 0 1.5rem;
  }

  .article-content :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: 1.8rem;
    line-height: 1.15;
  }

  .article-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(25 52 45 / 16%);
    color: #6e8b7c;
    font-size: 0.85rem;
  }

  .page-footer {
    color: #dfe9df;
    background: #19342d;
  }

  .page-footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    justify-content: initial;
    font-size: 0.82rem;
  }

  .page-footer p {
    margin: 0;
  }

  .page-footer a {
    color: #dfe9df;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-header {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 38rem) {
    .page-header-inner,
    .page-footer-inner,
    .article-shell {
      width: min(100% - 2rem, 72rem);
    }

    .page-header-inner,
    .page-footer-inner {
      min-height: 6.5rem;
    }

    .page-header-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
    }

    .page-footer-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      justify-content: initial;
      min-height: 6.5rem;
      padding: 1rem 0;
    }

    .page-footer-inner > a:not(.conquense-credit) {
      grid-column: 1;
      grid-row: 2;
    }

    .page-footer-inner > .conquense-credit {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
