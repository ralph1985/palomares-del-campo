---
import { getCollection, render } from 'astro:content';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('noticias');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, author, authorType, date, sourceName, sourceUrl, category } = post.data;
const formattedDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<BaseLayout
  title={`${title} · Palomares del Campo`}
  description={description}
  canonicalPath={`/noticias/${post.id}/`}
  type="article"
  schema="article"
  article={{
    headline: title,
    author,
    authorType,
    datePublished: date,
    sourceUrl,
    ...(category === undefined ? {} : { section: category }),
  }}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Noticias', path: '/noticias/' },
    { name: title, path: `/noticias/${post.id}/` },
  ]}
>
  <main class="article-shell">
    <a class="back-link" href="/noticias">
      ← Volver a noticias
    </a>
    <article>
      <header class="article-header">
        <p class="eyebrow">{category ?? 'Actualidad'}</p>
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-meta">
          <span>{author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>
      </header>

      <div class="article-content">
        <Content />
      </div>

      <footer class="article-source">
        <span>Fuente original:</span>
        <ExternalLink href={sourceUrl}>{sourceName} ↗</ExternalLink>
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  .page-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgb(25 52 45 / 12%);
    background: rgb(244 241 233 / 92%);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .page-header.is-hidden {
    transform: translateY(-105%);
  }

  .page-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2.5rem, 72rem);
    min-height: 5.25rem;
    margin: 0 auto;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: var(--font-weight-strong);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border-radius: 0.8rem;
    color: var(--color-paper);
    background: var(--color-forest);
    font-family: var(--font-serif);
    font-size: 1.3rem;
  }

  .home-link,
  .back-link,
  .article-source a {
    color: var(--color-forest);
    font-size: 0.85rem;
    font-weight: var(--font-weight-strong);
    text-decoration: none;
  }

  .home-link:hover,
  .home-link:focus-visible,
  .back-link:hover,
  .back-link:focus-visible,
  .article-source a:hover,
  .article-source a:focus-visible,
  .brand:focus-visible {
    color: var(--color-clay);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .article-shell {
    width: min(100% - 2.5rem, 54rem);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 7rem) 0;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 3rem;
  }

  .article-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgb(25 52 45 / 16%);
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-clay);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 7vw, 5.7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .article-description {
    max-width: 42rem;
    margin: 2rem 0 1.5rem;
    color: var(--color-muted);
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--color-clay);
    font-size: 0.78rem;
    font-weight: var(--font-weight-strong);
    text-transform: uppercase;
  }

  .article-content {
    padding: 3rem 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .article-content :global(p) {
    margin: 0 0 1.5rem;
  }

  .article-content :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: 1.8rem;
    line-height: 1.15;
  }

  .article-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(25 52 45 / 16%);
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-header {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 38rem) {
    .page-header-inner,
    .article-shell {
      width: min(100% - 2rem, 72rem);
    }

    .page-header-inner {
      min-height: 6.5rem;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
