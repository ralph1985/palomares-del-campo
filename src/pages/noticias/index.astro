---
import { getCollection } from 'astro:content';
import CollectionArchive from '../../components/CollectionArchive.astro';
import NewsCard from '../../components/NewsCard.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import '../../styles/global.css';

const posts = (await getCollection('noticias')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const categories = [...new Set(posts.map((post) => post.data.category ?? 'Actualidad'))].sort(
  (a, b) => a.localeCompare(b, 'es'),
);
const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))].sort((a, b) => b - a);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Noticias publicadas sobre Palomares del Campo y su entorno."
    />
    <title>Noticias · Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="news-hero" aria-labelledby="page-title">
        <div class="news-hero-inner">
          <p class="eyebrow">Palomares del Campo · Actualidad</p>
          <h1 id="page-title">Noticias</h1>
          <p>
            Noticias publicadas sobre el pueblo, sus vecinos y los proyectos que afectan a su
            entorno.
          </p>
        </div>
      </section>

      <CollectionArchive
        scope="news"
        headingId="archive-title"
        eyebrow="Archivo editorial"
        title="Todas las noticias"
        total={posts.length}
        itemSingular="noticia publicada"
        itemPlural="noticias publicadas"
        emptyMessage="Todavía no hay noticias publicadas."
        searchLabel="Buscar en noticias"
        inputId="news-search"
        placeholder="Ej. carretera, fiestas o agua"
        action="/noticias/"
        categories={categories}
        years={years}
      >
        {posts.map((post) => (
          <NewsCard post={post} />
        ))}
      </CollectionArchive>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .page-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgb(25 52 45 / 12%);
    background: rgb(244 241 233 / 92%);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .page-header.is-hidden {
    transform: translateY(-105%);
  }
  .page-header-inner,
  .news-hero-inner {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }
  .page-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5.25rem;
    gap: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #19342d;
    font-size: 0.95rem;
    font-weight: 750;
    text-decoration: none;
  }
  .brand-mark {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border-radius: 0.8rem;
    color: #f4f1e9;
    background: #2f6652;
    font-family: Georgia, serif;
    font-size: 1.3rem;
  }
  .home-link {
    color: #2f6652;
    font-size: 0.85rem;
    font-weight: 750;
    text-decoration: none;
  }
  .home-link:hover,
  .home-link:focus-visible,
  .brand:focus-visible {
    color: #a05c32;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  .news-hero {
    padding: clamp(5rem, 13vw, 10rem) 0 clamp(4rem, 9vw, 7rem);
    background: #19342d;
  }
  .news-hero-inner {
    color: #eff5ed;
  }
  .eyebrow {
    margin: 0 0 1rem;
    color: #e5b77e;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(4rem, 11vw, 8rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }
  .news-hero p:last-child {
    max-width: 34rem;
    margin: 2rem 0 0;
    color: #b7d0bc;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.65;
  }
  @media (prefers-reduced-motion: reduce) {
    .page-header {
      transition-duration: 0.01ms;
    }
  }
  @media (max-width: 38rem) {
    .page-header-inner,
    .news-hero-inner {
      width: min(100% - 2rem, 72rem);
    }
    .page-header-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      min-height: 6.5rem;
    }
  }
</style>
