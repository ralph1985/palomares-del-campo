---
import { getCollection } from 'astro:content';
import CollectionArchive from '../../components/CollectionArchive.astro';
import EditorialHero from '../../components/hero/EditorialHero.astro';
import NewsCard from '../../components/NewsCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('noticias')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const categories = [...new Set(posts.map((post) => post.data.category ?? 'Actualidad'))].sort(
  (a, b) => a.localeCompare(b, 'es'),
);
const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))].sort((a, b) => b - a);
---

<BaseLayout
  title="Noticias · Palomares del Campo"
  description="Noticias publicadas sobre Palomares del Campo y su entorno."
>
  <main>
    <EditorialHero labelledBy="page-title" variant="ink-display">
      <p slot="eyebrow" class="eyebrow">
        Palomares del Campo · Actualidad
      </p>
      <h1 slot="title" id="page-title">
        Noticias
      </h1>
      <p slot="summary" class="hero-intro">
        Noticias publicadas sobre el pueblo, sus vecinos y los proyectos que afectan a su entorno.
      </p>
    </EditorialHero>

    <CollectionArchive
      scope="news"
      headingId="archive-title"
      eyebrow="Archivo editorial"
      title="Todas las noticias"
      total={posts.length}
      itemSingular="noticia publicada"
      itemPlural="noticias publicadas"
      emptyMessage="Todavía no hay noticias publicadas."
      searchLabel="Buscar en noticias"
      inputId="news-search"
      placeholder="Ej. carretera, fiestas o agua"
      action="/noticias/"
      categories={categories}
      years={years}
    >
      {posts.map((post) => (
        <NewsCard post={post} />
      ))}
    </CollectionArchive>
  </main>
</BaseLayout>

<style>
  .page-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgb(25 52 45 / 12%);
    background: rgb(244 241 233 / 92%);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .page-header.is-hidden {
    transform: translateY(-105%);
  }
  .page-header-inner {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }
  .page-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5.25rem;
    gap: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: var(--font-weight-strong);
    text-decoration: none;
  }
  .brand-mark {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border-radius: 0.8rem;
    color: var(--color-paper);
    background: var(--color-forest);
    font-family: var(--font-serif);
    font-size: 1.3rem;
  }
  .home-link {
    color: var(--color-forest);
    font-size: 0.85rem;
    font-weight: var(--font-weight-strong);
    text-decoration: none;
  }
  .home-link:hover,
  .home-link:focus-visible,
  .brand:focus-visible {
    color: var(--color-clay);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-header {
      transition-duration: 0.01ms;
    }
  }
  @media (max-width: 38rem) {
    .page-header-inner {
      width: min(100% - 2rem, 72rem);
    }
    .page-header-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      min-height: 6.5rem;
    }
  }
</style>
