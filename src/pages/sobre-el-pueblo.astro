---
import { getImage, inferRemoteSize } from 'astro:assets';
import ExternalLink from '../components/ui/ExternalLink.astro';
import AboutEmblem from '../components/about/AboutEmblem.astro';
import HeritageCard from '../components/about/HeritageCard.astro';
import PatronalFestivities from '../components/about/PatronalFestivities.astro';
import SplitHero from '../components/hero/SplitHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutPalomares } from '../data/about-palomares';
import { getResponsiveImageWidths, optimizeRemoteImage } from '../images';
import '../styles/pages/sobre-el-pueblo.css';

const optimizeAboutImage = (
  source: string,
  imageDimensions: { width: number; height: number },
  candidateWidths: number[],
  sizes: string,
) =>
  optimizeRemoteImage(
    source,
    () => (import.meta.env.PROD ? inferRemoteSize(source) : Promise.resolve(imageDimensions)),
    (sourceDimensions) =>
      getImage({
        src: source,
        width: imageDimensions.width,
        height: imageDimensions.height,
        widths: getResponsiveImageWidths(sourceDimensions.width, candidateWidths),
        sizes,
        format: 'webp',
        quality: 85,
      }),
    (error) =>
      console.warn(
        `Could not optimize an about-page image; preserving its source URL: ${source}`,
        error,
      ),
  );

const [heroImage, landscapeImage] = await Promise.all([
  optimizeAboutImage(
    aboutPalomares.heroImage.src,
    { width: 592, height: 890 },
    [320, 480, 592, 890],
    '(max-width: 48rem) calc(100vw - 2rem), 40vw',
  ),
  optimizeAboutImage(
    aboutPalomares.landscape.image.src,
    { width: 755, height: 566 },
    [320, 480, 755, 1000],
    '(max-width: 48rem) calc(100vw - 2rem), 50vw',
  ),
]);
---

<BaseLayout
  title={`${aboutPalomares.pageTitle} · Palomares del Campo`}
  description={aboutPalomares.pageDescription}
  socialImage={heroImage.transformed?.src ?? heroImage.source}
  socialImageAlt={aboutPalomares.heroImage.alt}
>
  <main>
    <SplitHero variant="heritage" labelledBy="page-title">
      <div slot="copy" class="about-hero-copy">
        <p class="eyebrow">{aboutPalomares.landingEyebrow}</p>
        <h1 id="page-title">{aboutPalomares.landingTitle}</h1>
        <p class="hero-intro">{aboutPalomares.landingIntro}</p>
        <a class="hero-link" href="#historia">
          Descubrir el pueblo <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div slot="visual" class="hero-emblem">
        <AboutEmblem />
        <div class="hero-emblem-orbit hero-emblem-orbit--one" aria-hidden="true"></div>
        <div class="hero-emblem-orbit hero-emblem-orbit--two" aria-hidden="true"></div>
        <figure class="hero-photo">
          <img
            src={heroImage.transformed?.src ?? heroImage.source}
            srcset={heroImage.transformed?.srcSet.attribute}
            sizes="(max-width: 48rem) calc(100vw - 2rem), 40vw"
            width={heroImage.transformed?.options.width ?? 592}
            height={heroImage.transformed?.options.height ?? 890}
            alt={aboutPalomares.heroImage.alt}
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>
            <ExternalLink href={aboutPalomares.heroImage.sourceHref}>
              {aboutPalomares.heroImage.sourceLabel} <span aria-hidden="true">↗</span>
            </ExternalLink>
          </figcaption>
        </figure>
      </div>
    </SplitHero>

    <section class="history-section" id="historia" aria-labelledby="history-title">
      <div class="about-shell history-grid">
        <div class="section-intro">
          <p class="eyebrow">{aboutPalomares.history.eyebrow}</p>
          <h2 id="history-title">{aboutPalomares.history.title}</h2>
        </div>
        <div class="history-copy">
          {aboutPalomares.history.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <ExternalLink class="source-link" href={aboutPalomares.history.source.href}>
            {aboutPalomares.history.source.label} <span aria-hidden="true">↗</span>
          </ExternalLink>
        </div>
      </div>
    </section>

    <section class="heritage-section" id="patrimonio" aria-labelledby="heritage-title">
      <div class="about-shell">
        <div class="section-heading section-heading--wide">
          <div>
            <p class="eyebrow">Patrimonio</p>
            <h2 id="heritage-title">Piedra, agua y memoria</h2>
          </div>
          <p>
            El patrimonio de Palomares no se agota en un edificio: también está en los lugares que
            explican cómo se habitó y se recorrió este territorio.
          </p>
        </div>

        <div class="heritage-grid">
          {aboutPalomares.heritage.map((feature, index) => (
            <HeritageCard {...feature} index={index} />
          ))}
        </div>
      </div>
    </section>

    <section class="landscape-section" id="paisaje" aria-labelledby="landscape-title">
      <div class="about-shell landscape-grid">
        <figure class="landscape-photo">
          <img
            src={landscapeImage.transformed?.src ?? landscapeImage.source}
            srcset={landscapeImage.transformed?.srcSet.attribute}
            sizes="(max-width: 48rem) calc(100vw - 2rem), 50vw"
            width={landscapeImage.transformed?.options.width ?? 755}
            height={landscapeImage.transformed?.options.height ?? 566}
            alt={aboutPalomares.landscape.image.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <ExternalLink href={aboutPalomares.landscape.image.sourceHref}>
              {aboutPalomares.landscape.image.sourceLabel} <span aria-hidden="true">↗</span>
            </ExternalLink>
          </figcaption>
        </figure>
        <div class="landscape-copy">
          <p class="eyebrow">{aboutPalomares.landscape.eyebrow}</p>
          <h2 id="landscape-title">{aboutPalomares.landscape.title}</h2>
          <p>{aboutPalomares.landscape.text}</p>
          <div class="landscape-actions">
            <ExternalLink class="button-link" href={aboutPalomares.landscape.directions.href}>
              {aboutPalomares.landscape.directions.label} <span aria-hidden="true">↗</span>
            </ExternalLink>
            <ExternalLink class="source-link" href={aboutPalomares.landscape.source.href}>
              {aboutPalomares.landscape.source.label} <span aria-hidden="true">↗</span>
            </ExternalLink>
          </div>
        </div>
      </div>
    </section>

    <PatronalFestivities />

    <section class="sources-section" aria-labelledby="sources-title">
      <div class="about-shell sources-inner">
        <div>
          <p class="eyebrow">Para seguir leyendo</p>
          <h2 id="sources-title">Fuentes consultadas</h2>
        </div>
        <nav aria-label="Fuentes de la sección Sobre Palomares del Campo">
          <ul class="sources-list">
            {aboutPalomares.sources.map((source) => (
              <li>
                <ExternalLink href={source.href}>
                  {source.label} <span aria-hidden="true">↗</span>
                </ExternalLink>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </section>
  </main>
</BaseLayout>
