---
import CurrentAffairsEmptyState from '../../components/current-affairs/CurrentAffairsEmptyState.astro';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import { noticeItems } from '../../data/current-affairs';

const hasNotices = noticeItems.length > 0;
const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Avisos vigentes para Palomares del Campo." />
    <title>Avisos · Palomares del Campo</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      {hasNotices ? (
        <section class="notices-section" aria-labelledby="notices-title">
          <div class="notices-shell">
            <p class="eyebrow">Actualidad · Avisos</p>
            <h1 id="notices-title">Avisos</h1>
            <div class="notice-list">
              {noticeItems.map((notice) => (
                <article class="notice-card">
                  <p class="notice-date">Publicado el {formatDate(notice.publishedAt)}</p>
                  <h2>{notice.title}</h2>
                  <p>{notice.summary}</p>
                  <ExternalLink href={notice.source.href}>
                    {notice.source.label} <span aria-hidden="true">↗</span>
                  </ExternalLink>
                </article>
              ))}
            </div>
          </div>
        </section>
      ) : (
        <CurrentAffairsEmptyState
          section="avisos"
          eyebrow="Actualidad · Avisos"
          title="Avisos"
          description="Este espacio queda reservado para avisos vigentes que necesiten una lectura rápida y una fuente pública."
          emptyMessage="No hay avisos vigentes."
        />
      )}
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #19342d;
    background: #f4f1e9;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }

  .notices-section {
    min-height: calc(100vh - 10.5rem);
    padding: clamp(5rem, 12vw, 9rem) 0;
    background: #f0dfc9;
  }

  .notices-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 1.2rem;
    color: #a05c32;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  h1 {
    font-size: clamp(4rem, 12vw, 9rem);
  }

  .notice-list {
    display: grid;
    gap: 1rem;
    margin-top: 4rem;
  }

  .notice-card {
    display: grid;
    gap: 0.8rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.25rem;
    background: #f4f1e9;
  }

  .notice-card h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .notice-card p {
    max-width: 42rem;
    margin: 0;
    color: #527066;
    line-height: 1.6;
  }

  .notice-card .notice-date {
    color: #a05c32;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .notice-card a {
    width: fit-content;
    color: #19342d;
    font-weight: 750;
    text-underline-offset: 0.25em;
  }
</style>
