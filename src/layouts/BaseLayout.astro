---
import SEO from '../components/SEO.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import PageTransition from '../components/layout/PageTransition.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { PUBLIC_PAGE_TRANSITIONS_ENABLED } from 'astro:env/client';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  canonicalPath?: string;
  socialImage?: string;
  socialImageAlt?: string;
  type?: 'website' | 'article';
  schema?: 'website' | 'article';
  noindex?: boolean;
  article?: {
    headline?: string;
    author: string;
    authorType: 'Person' | 'Organization';
    datePublished: Date;
    sourceUrl?: string;
    section?: string;
  };
  breadcrumbs?: Array<{
    name: string;
    path: string;
  }>;
}

const {
  title,
  description,
  bodyClass,
  canonicalPath,
  socialImage,
  socialImageAlt,
  type,
  schema,
  noindex,
  article,
  breadcrumbs,
} = Astro.props;

const seoProps = {
  title,
  description,
  ...(canonicalPath === undefined ? {} : { canonicalPath }),
  ...(socialImage === undefined ? {} : { image: socialImage }),
  ...(socialImageAlt === undefined ? {} : { imageAlt: socialImageAlt }),
  ...(type === undefined ? {} : { type }),
  ...(schema === undefined ? {} : { schema }),
  ...(noindex === undefined ? {} : { noindex }),
  ...(article === undefined ? {} : { article }),
  ...(breadcrumbs === undefined ? {} : { breadcrumbs }),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
      sizes="16x16 32x32 48x48 64x64 128x128 256x256"
    />
    <SEO {...seoProps} />
    <script is:inline define:vars={{ pageTransitionsEnabled: PUBLIC_PAGE_TRANSITIONS_ENABLED }}>
      try {
        if (!pageTransitionsEnabled) {
          sessionStorage.removeItem('palomares-page-transition');
        } else if (sessionStorage.getItem('palomares-page-transition') === 'incoming') {
          sessionStorage.removeItem('palomares-page-transition');
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.dataset.pageTransitionState = 'incoming';
            window.setTimeout(() => {
              if (document.documentElement.dataset.pageTransitionState === 'incoming') {
                document.documentElement.removeAttribute('data-page-transition-state');
              }
            }, 3200);
          }
        }
      } catch {
        // Storage can be disabled; the page remains visible and navigable.
      }
    </script>
    <slot name="head" />
  </head>
  <body
    class={bodyClass}
    data-page-transitions-enabled={PUBLIC_PAGE_TRANSITIONS_ENABLED ? 'true' : 'false'}
  >
    <SiteHeader />
    {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
    <slot />
    <SiteFooter />
    <PageTransition enabled={PUBLIC_PAGE_TRANSITIONS_ENABLED} />
  </body>
</html>
