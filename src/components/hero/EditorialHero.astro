---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  fullHeight?: boolean;
  id?: string;
  labelledBy: string;
  titleWidth?: 'narrow' | 'wide';
  summaryWidth?: 'wide';
  variant: 'paper' | 'sage' | 'paper-compact';
}

const {
  id,
  labelledBy,
  titleWidth,
  summaryWidth,
  fullHeight,
  variant,
  class: className,
  ...sectionAttributes
} = Astro.props;
---

<section
  {...sectionAttributes}
  id={id}
  class:list={[
    'editorial-hero',
    `editorial-hero--${variant}`,
    fullHeight && 'editorial-hero--viewport',
    titleWidth && `editorial-hero--title-${titleWidth}`,
    summaryWidth && `editorial-hero--summary-${summaryWidth}`,
    className,
  ]}
  aria-labelledby={labelledBy}
>
  <div class="editorial-hero__inner">
    <slot name="eyebrow" />
    <slot name="title" />
    <slot name="summary" />
    {Astro.slots.has('notice') && (
      <div class="editorial-hero__notice">
        <slot name="notice" />
      </div>
    )}
    {Astro.slots.has('actions') && (
      <div class="editorial-hero__actions">
        <slot name="actions" />
      </div>
    )}
  </div>
</section>

<style>
  .editorial-hero {
    --hero-gutter: min(100% - 2.5rem, 72rem);
    padding: clamp(3rem, 5.5vw, 4.5rem) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .editorial-hero__inner {
    width: var(--hero-gutter);
    margin: 0 auto;
  }

  .editorial-hero__inner::before {
    display: block;
    width: 2rem;
    height: 2px;
    margin-bottom: 1.1rem;
    background: var(--color-clay);
    content: '';
  }

  .editorial-hero--sage {
    background: var(--color-sage);
  }

  .editorial-hero--paper-compact {
    padding: clamp(2.5rem, 4vw, 3.25rem) 0;
  }

  .editorial-hero--viewport {
    display: grid;
    align-content: center;
    min-height: min(32rem, calc(100vh - 5.25rem));
  }

  .editorial-hero--viewport :global(.hero-intro) {
    max-width: 34rem;
  }

  .editorial-hero :global(.eyebrow) {
    margin: 0 0 1.1rem;
    color: var(--color-clay-text);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .editorial-hero :global(h1) {
    max-width: 15ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--font-size-page-title);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .editorial-hero--title-narrow :global(h1) {
    max-width: 9ch;
  }

  .editorial-hero--title-wide :global(h1) {
    max-width: 20ch;
  }

  .editorial-hero :global(.hero-intro) {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.7;
  }

  .editorial-hero--summary-wide :global(.hero-intro) {
    max-width: 42rem;
  }

  .editorial-hero__actions {
    margin-top: 1.5rem;
  }

  @media (max-width: 38rem) {
    .editorial-hero {
      --hero-gutter: min(100% - 2rem, 72rem);
    }

    .editorial-hero--viewport {
      min-height: calc(100vh - 10.25rem);
    }
  }
</style>
