---
import type { HeritageFeature } from '../../data/about-palomares';
import ExternalLink from '../ui/ExternalLink.astro';

interface Props extends HeritageFeature {
  index: number;
}

const { eyebrow, title, description, body, source, index } = Astro.props;
---

<article class:list={['heritage-card', { 'heritage-card--offset': index % 2 === 1 }]}>
  <p class="heritage-card-eyebrow">{eyebrow}</p>
  <h3>{title}</h3>
  <p class="heritage-card-description">{description}</p>
  <p class="heritage-card-body">{body}</p>
  <ExternalLink href={source.href}>
    {source.label} <span aria-hidden="true">↗</span>
  </ExternalLink>
</article>

<style>
  .heritage-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid rgb(25 52 45 / 14%);
    background: var(--color-paper);
  }

  .heritage-card--offset {
    background: var(--color-surface-soft);
  }

  .heritage-card-eyebrow {
    margin: 0 0 1rem;
    color: var(--color-clay);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h3 {
    max-width: 14ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .heritage-card-description {
    margin: 1.5rem 0 0;
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    line-height: 1.5;
  }

  .heritage-card-body {
    margin: 1rem 0 2rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  a {
    width: fit-content;
    margin-top: auto;
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: var(--font-weight-strong);
    text-decoration: none;
  }

  a span {
    margin-left: 0.25rem;
    font-size: 1rem;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  a:focus-visible {
    outline: 3px solid var(--color-clay);
    outline-offset: 4px;
  }
</style>
