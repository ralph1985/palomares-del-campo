---
<div class="about-emblem-scene" data-about-emblem aria-hidden="true">
  <img
    src="/brand/escudo-palomares-del-campo.svg"
    alt=""
    width="228"
    height="396"
    decoding="async"
  />
  <canvas data-about-emblem-canvas></canvas>
</div>
<script>
  import '../../scripts/about-emblem.ts';
</script>
<style>
  .about-emblem-scene {
    position: absolute;
    z-index: 0;
    width: min(13rem, 56vw);
    aspect-ratio: 1.42 / 2.475;
    opacity: 0.52;
    pointer-events: none;
    transform: translate(-38%, 8%) rotate(-8deg);
  }

  .about-emblem-scene img,
  .about-emblem-scene canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .about-emblem-scene canvas {
    opacity: 0;
    transition: opacity 420ms ease;
  }

  .about-emblem-scene.is-ready canvas {
    opacity: 1;
  }

  .about-emblem-scene.is-ready img {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-emblem-scene canvas {
      transition: none;
    }
  }
</style>
