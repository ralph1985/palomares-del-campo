---
import EditorialHero from '../hero/EditorialHero.astro';

interface Props {
  section: 'agenda' | 'avisos';
  eyebrow: string;
  title: string;
  description: string;
  emptyMessage: string;
}

const { section, eyebrow, title, description, emptyMessage } = Astro.props;
---

<EditorialHero
  class="current-affairs-empty"
  variant="paper"
  fullHeight
  labelledBy={`${section}-title`}
  data-current-affairs-empty
  data-section={section}
>
  <p slot="eyebrow" class="eyebrow">
    {eyebrow}
  </p>
  <h1 slot="title" id={`${section}-title`}>
    {title}
  </h1>
  <p slot="summary" class="hero-intro empty-description">
    {description}
  </p>
  <p slot="notice" class="empty-message">
    {emptyMessage}
  </p>
  <a slot="actions" class="back-link" href="/">
    Volver al inicio <span aria-hidden="true">→</span>
  </a>
</EditorialHero>

<style>
  .empty-message {
    width: fit-content;
    max-width: 100%;
    margin: 3rem 0 0;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    color: var(--color-forest);
    background: var(--color-surface-soft);
    font-weight: 700;
  }

  .back-link {
    display: inline-block;
    margin-top: 0;
    color: var(--color-forest);
    font-weight: var(--font-weight-strong);
    text-underline-offset: 0.25em;
  }

  @media (max-width: 38rem) {
    .empty-message {
      margin-top: 2rem;
    }
  }
</style>
