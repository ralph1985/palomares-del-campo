---
import ConquenseCredit from './ConquenseCredit.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import { footerExploreLinks, footerQuickLinks, municipalContact } from '../../data/site-footer';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="contacto">
  <div class="footer-inner">
    <section class="footer-brand" aria-labelledby="footer-brand-title">
      <a class="footer-brand-link" href="/" aria-label="Palomares del Campo, inicio">
        <img
          src="/brand/escudo-palomares-del-campo.svg"
          alt=""
          width="44"
          height="76"
          loading="lazy"
        />
        <span>
          <span class="footer-eyebrow">Información municipal</span>
          <strong id="footer-brand-title">Palomares del Campo</strong>
        </span>
      </a>
      <p>Información, historias y lugares para descubrir el pueblo.</p>
    </section>

    <nav class="footer-group" aria-labelledby="footer-explore-title">
      <h2 id="footer-explore-title">Explora</h2>
      <ul>
        {footerExploreLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer-group" aria-labelledby="footer-official-title">
      <h2 id="footer-official-title">Enlaces oficiales</h2>
      <ul>
        {footerQuickLinks.map((link) => (
          <li>
            <ExternalLink href={link.href}>
              {link.label}
              <span aria-hidden="true">↗</span>
            </ExternalLink>
          </li>
        ))}
        <li>
          <a href="/informacion-practica/">Ver todos los servicios municipales</a>
        </li>
        <li>
          <a href="/privacidad/">Privacidad y protección de datos</a>
        </li>
        <li>
          <a href="/politica-de-cookies/">Política de cookies</a>
        </li>
        <li>
          <a href="/aviso-legal/">Aviso legal</a>
        </li>
      </ul>
    </nav>

    <address class="footer-group footer-contact" aria-labelledby="footer-contact-title">
      <h2 id="footer-contact-title">Contacto</h2>
      <p>{municipalContact.name}</p>
      <p>
        {municipalContact.address}
        <br />
        {municipalContact.locality}
      </p>
      <p>{municipalContact.judicialDistrict}</p>
      <a href={`tel:${municipalContact.phoneHref}`}>{municipalContact.phone}</a>
      <a href={`mailto:${municipalContact.email}`}>{municipalContact.email}</a>
    </address>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p>© {currentYear} Palomares del Campo</p>
      <ConquenseCredit />
    </div>
  </div>

  <button type="button" class="back-to-top" data-back-to-top aria-label="Volver arriba" hidden>
    <span aria-hidden="true">↑</span>
  </button>
</footer>

<style>
  .site-footer {
    color: var(--color-surface-soft);
    background: var(--color-ink);
  }

  .footer-inner,
  .footer-bottom-inner {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(15rem, 1.25fr) repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
    padding: 4.5rem 0 4rem;
  }

  .footer-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: inherit;
    text-decoration: none;
  }

  .footer-brand-link img {
    display: block;
    width: 2.75rem;
    height: 4.75rem;
    object-fit: contain;
  }

  .footer-brand-link strong,
  .footer-eyebrow {
    display: block;
  }

  .footer-brand-link strong {
    max-width: 10rem;
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1;
  }

  .footer-eyebrow {
    margin-bottom: 0.45rem;
    color: var(--color-ochre);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-brand p {
    max-width: 15rem;
    margin: 1.5rem 0 0;
    color: var(--color-sage-light);
    font-size: var(--font-size-small);
    line-height: 1.6;
  }

  .footer-group {
    min-width: 0;
  }

  .footer-group h2 {
    margin: 0 0 1rem;
    color: var(--color-paper);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-group ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-group a {
    color: var(--color-sage-light);
    font-size: 0.87rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .footer-group a span {
    display: inline-block;
    margin-left: 0.3rem;
    color: var(--color-ochre);
    font-size: 0.8rem;
  }

  .footer-group a:hover,
  .footer-group a:focus-visible {
    color: var(--color-ochre);
  }

  .footer-group a:focus-visible,
  .footer-brand-link:focus-visible {
    outline: 3px solid var(--color-ochre);
    outline-offset: 5px;
    border-radius: 0.2rem;
  }

  .footer-contact {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    color: var(--color-sage-light);
    font-size: 0.87rem;
    font-style: normal;
    line-height: 1.5;
  }

  .footer-contact h2 {
    margin-bottom: 0.5rem;
  }

  .footer-contact p {
    margin: 0;
  }

  .footer-contact a {
    width: fit-content;
  }

  .footer-bottom {
    border-top: 1px solid rgb(223 233 223 / 18%);
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5.75rem;
  }

  .footer-bottom-inner > p {
    margin: 0;
    color: var(--color-sage-light);
    font-size: 0.78rem;
  }

  .footer-bottom :global(.conquense-credit) {
    color: var(--color-surface-soft);
  }

  @media (max-width: 60rem) {
    .footer-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  .back-to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 1050;
    display: grid;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    color: var(--color-ink);
    background: var(--color-ochre);
    box-shadow: 0 0.65rem 1.5rem rgb(25 52 45 / 22%);
    font-size: 1.25rem;
    font-weight: var(--font-weight-emphasis);
    line-height: 1;
    cursor: pointer;
    transition:
      transform 180ms ease,
      background-color 180ms ease;
  }

  .back-to-top[hidden] {
    display: none;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    background: var(--color-ochre);
    transform: translateY(-0.2rem);
  }

  .back-to-top:focus-visible {
    outline: 3px solid var(--color-paper);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 38rem) {
    .footer-inner,
    .footer-bottom-inner {
      width: min(100% - 2rem, 72rem);
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding: 3.5rem 0;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-bottom-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.25rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-group a {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');

  if (backToTop) {
    const updateBackToTopVisibility = () => {
      backToTop.hidden = window.scrollY < 480;
    };

    window.addEventListener('scroll', updateBackToTopVisibility, { passive: true });
    updateBackToTopVisibility();

    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
