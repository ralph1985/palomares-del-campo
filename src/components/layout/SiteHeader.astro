---
---
<header class="site-header" data-auto-hide-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Palomares del Campo, inicio">
      <span class="brand-mark" aria-hidden="true">
        <img src="/brand/escudo-palomares-del-campo.svg" alt="" width="64" height="112" />
      </span>
      <span>Palomares del Campo</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      data-menu-toggle
      aria-controls="site-menu"
      aria-expanded="false"
    >
      <span class="menu-toggle-label">Explorar</span>
      <span class="menu-toggle-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<button class="menu-backdrop" type="button" data-menu-backdrop hidden aria-label="Cerrar menú"></button>

<aside class="side-menu" id="site-menu" aria-label="Menú lateral" aria-hidden="true" inert>
  <div class="side-menu-inner">
    <div class="side-menu-header">
      <p class="menu-kicker">Palomares del Campo</p>
      <button class="menu-close" type="button" data-menu-close aria-label="Cerrar menú">
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <div class="side-menu-content">
      <nav aria-label="Secciones del sitio">
        <ul class="side-nav">
          <li><a href="/#inicio"><span>01</span>Inicio</a></li>
          <li><a href="/#proyecto"><span>02</span>El proyecto</a></li>
          <li><a href="/noticias"><span>03</span>Noticias</a></li>
          <li><a href="/#contacto"><span>04</span>Contacto</a></li>
        </ul>
      </nav>

      <div class="menu-visual">
        <canvas id="menu-scene" aria-hidden="true"></canvas>
        <div class="menu-visual-copy">
          <span class="visual-pulse" aria-hidden="true"></span>
          <p>El paisaje también puede moverse.</p>
          <small>Una primera coordenada para lo que viene.</small>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  import '../../scripts/menu.ts';
  import '../../scripts/auto-hide-header.ts';
</script>

<style is:global>
  body.menu-is-open {
    overflow: hidden;
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgb(25 52 45 / 12%);
    background: rgb(244 241 233 / 92%);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .site-header.is-hidden {
    transform: translateY(-105%);
  }

  .site-header .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2.5rem, 72rem);
    min-height: 5.25rem;
    margin: 0 auto;
    gap: 2rem;
  }

  .site-header .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #19342d;
    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .site-header .brand-mark {
    display: grid;
    width: 2.45rem;
    height: 3.1rem;
    place-items: center;
    overflow: visible;
    border-radius: 0;
    color: #f4f1e9;
    background: transparent;
    font-family: Georgia, serif;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .site-header .brand-mark img {
    display: block;
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .menu-toggle,
  .menu-close {
    border: 0;
    cursor: pointer;
    font: inherit;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0;
    color: #19342d;
    background: transparent;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .menu-toggle-icon {
    display: grid;
    gap: 0.3rem;
    width: 1.5rem;
  }

  .menu-toggle-icon span {
    display: block;
    height: 2px;
    border-radius: 999px;
    background: #2f6652;
    transition: transform 220ms ease;
  }

  .menu-toggle-icon span:last-child {
    width: 70%;
    justify-self: end;
  }

  .menu-toggle:hover .menu-toggle-icon span:first-child,
  .menu-toggle:focus-visible .menu-toggle-icon span:first-child {
    transform: translateX(-0.2rem);
  }

  .menu-toggle:hover .menu-toggle-icon span:last-child,
  .menu-toggle:focus-visible .menu-toggle-icon span:last-child {
    transform: translateX(0.2rem);
  }

  .menu-toggle:focus-visible,
  .menu-close:focus-visible,
  .side-nav a:focus-visible,
  .site-header .brand:focus-visible {
    outline: 3px solid #c68455;
    outline-offset: 5px;
  }

  .menu-backdrop {
    position: fixed;
    z-index: 25;
    inset: 0;
    width: 100%;
    border: 0;
    background: rgb(13 29 25 / 52%);
    cursor: pointer;
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .menu-backdrop:not([hidden]) {
    opacity: 1;
  }

  .side-menu {
    position: fixed;
    z-index: 30;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100%, 31rem);
    overflow-y: auto;
    color: #eff5ed;
    background: #19342d;
    box-shadow: -1.5rem 0 4rem rgb(13 29 25 / 18%);
    transform: translateX(102%);
    transition: transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .side-menu.is-open {
    transform: translateX(0);
  }

  .side-menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 1.5rem clamp(1.5rem, 5vw, 3rem) 2rem;
  }

  .side-menu-header {
    position: sticky;
    z-index: 2;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: -1.5rem;
    padding: 1.5rem 0 1rem;
    background: #19342d;
    box-shadow: 0 1px 0 rgb(239 245 237 / 10%);
  }

  .menu-kicker {
    margin: 0;
    color: #e5b77e;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .menu-close {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgb(239 245 237 / 22%);
    border-radius: 50%;
    color: #eff5ed;
    background: transparent;
    font-size: 1.8rem;
    font-weight: 300;
    line-height: 1;
  }

  .menu-close:hover,
  .menu-close:focus-visible {
    border-color: #e5b77e;
    color: #e5b77e;
  }

  .side-menu-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding: clamp(4rem, 13vh, 8rem) 0 1rem;
  }

  .side-nav {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side-nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.65rem 0;
    color: #eff5ed;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 6vw, 3.2rem);
    letter-spacing: -0.045em;
    line-height: 1;
    text-decoration: none;
  }

  .side-nav a span {
    color: #8fb49c;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .side-nav a:hover,
  .side-nav a:focus-visible {
    color: #e5b77e;
  }

  .menu-visual {
    position: relative;
    min-height: 15rem;
    overflow: hidden;
    border: 1px solid rgb(239 245 237 / 14%);
    border-radius: 1.5rem;
    background: radial-gradient(circle at 52% 38%, #315f4e 0%, #214538 42%, #142a25 100%);
  }

  #menu-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .menu-visual::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 25%, rgb(13 29 25 / 72%) 100%);
    content: "";
    pointer-events: none;
  }

  .menu-visual-copy {
    position: absolute;
    z-index: 1;
    right: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
  }

  .menu-visual-copy p,
  .menu-visual-copy small {
    display: block;
    margin: 0;
  }

  .menu-visual-copy p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .menu-visual-copy small {
    margin-top: 0.35rem;
    color: #b7d0bc;
    font-size: 0.75rem;
  }

  .visual-pulse {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #e5b77e;
    box-shadow: 0 0 0 0.3rem rgb(229 183 126 / 16%);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .side-menu,
    .menu-backdrop,
    .menu-toggle-icon span {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 38rem) {
    .site-header .header-inner {
      width: min(100% - 2rem, 72rem);
      min-height: 5rem;
    }

    .menu-toggle-label {
      display: none;
    }
  }
</style>
