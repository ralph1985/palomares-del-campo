---
import SideMenu from './SideMenu.astro';
---

<header class="site-header" data-auto-hide-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Palomares del Campo, inicio">
      <span class="brand-mark" aria-hidden="true">
        <img src="/brand/escudo-palomares-del-campo.svg" alt="" width="64" height="112" />
      </span>
      <span>Palomares del Campo</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      data-menu-toggle
      aria-controls="site-menu"
      aria-expanded="false"
    >
      <span class="menu-toggle-label">Explorar</span>
      <span class="menu-toggle-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<SideMenu />

<script>
  import '../../scripts/auto-hide-header.ts';
</script>

<style is:global>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgb(25 52 45 / 12%);
    background: rgb(244 241 233 / 92%);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .site-header.is-hidden {
    transform: translateY(-105%);
  }

  .site-header .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2.5rem, 72rem);
    min-height: 5.25rem;
    margin: 0 auto;
    gap: 2rem;
  }

  .site-header .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #19342d;
    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .site-header .brand-mark {
    display: grid;
    width: 2.45rem;
    height: 2.75rem;
    place-items: center;
    overflow: hidden;
    border-radius: 0;
    color: #f4f1e9;
    background: transparent;
    font-family: Georgia, serif;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .site-header .brand-mark img {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0;
    border: 0;
    color: #19342d;
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .menu-toggle-icon {
    display: grid;
    gap: 0.3rem;
    width: 1.5rem;
  }

  .menu-toggle-icon span {
    display: block;
    height: 2px;
    border-radius: 999px;
    background: #2f6652;
    transition: transform 220ms ease;
  }

  .menu-toggle-icon span:last-child {
    width: 70%;
    justify-self: end;
  }

  .menu-toggle:hover .menu-toggle-icon span:first-child,
  .menu-toggle:focus-visible .menu-toggle-icon span:first-child {
    transform: translateX(-0.2rem);
  }

  .menu-toggle:hover .menu-toggle-icon span:last-child,
  .menu-toggle:focus-visible .menu-toggle-icon span:last-child {
    transform: translateX(0.2rem);
  }

  .menu-toggle:focus-visible,
  .site-header .brand:focus-visible {
    outline: 3px solid #c68455;
    outline-offset: 5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .menu-toggle-icon span {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 38rem) {
    .site-header .header-inner {
      width: min(100% - 2rem, 72rem);
      min-height: 5rem;
    }

    .menu-toggle-label {
      display: none;
    }
  }
</style>
