---
import SideMenu from './SideMenu.astro';
---

<header class="site-header" data-auto-hide-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Palomares del Campo, inicio">
      <span class="brand-mark" aria-hidden="true">
        <img src="/brand/escudo-palomares-del-campo.svg" alt="" width="64" height="112" />
      </span>
      <span class="brand-name">
        <span class="brand-name-main">Palomares</span>
        <span class="brand-name-sub">del Campo</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      data-menu-toggle
      aria-label="Explorar"
      aria-controls="site-menu"
      aria-expanded="false"
    >
      <span class="menu-toggle-label">Explorar</span>
      <span class="menu-toggle-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<SideMenu />

<script>
  import '../../scripts/auto-hide-header.ts';
</script>

<style is:global>
  .site-header {
    position: sticky;
    z-index: 1100;
    top: 0;
    border-top: 3px solid var(--color-clay);
    border-bottom: 1px solid rgb(25 52 45 / 12%);
    background: var(--color-paper);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .site-header.is-hidden {
    transform: translateY(-105%);
  }

  .site-header .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2.5rem, 72rem);
    min-height: 5.75rem;
    margin: 0 auto;
    gap: 2rem;
  }

  .site-header .brand {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-header .brand-name {
    display: grid;
    gap: 0.2rem;
  }

  .site-header .brand-name-main {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
  }

  .site-header .brand-name-sub {
    color: var(--color-clay);
    font-size: 0.66rem;
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.15em;
    line-height: 1;
    text-transform: uppercase;
  }

  .site-header .brand-mark {
    display: grid;
    width: 3.35rem;
    height: 3.5rem;
    place-items: center;
    overflow: hidden;
    border-radius: 0.65rem;
    padding: 0.2rem;
    color: var(--color-paper);
    background: var(--color-sage);
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
  }

  .site-header .brand-mark img {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.6rem 1rem;
    border: 0;
    border-radius: 999px;
    color: var(--color-surface-soft);
    background: var(--color-forest);
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .menu-toggle-icon {
    display: grid;
    gap: 0.3rem;
    width: 1.35rem;
  }

  .menu-toggle-icon span {
    display: block;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 220ms ease;
  }

  .menu-toggle-icon span:last-child {
    width: 70%;
    justify-self: end;
  }

  .menu-toggle:hover .menu-toggle-icon span:first-child,
  .menu-toggle:focus-visible .menu-toggle-icon span:first-child {
    transform: translateX(-0.2rem);
  }

  .menu-toggle:hover {
    background: var(--color-ink);
    transform: translateY(-1px);
  }

  .menu-toggle:hover .menu-toggle-icon span:last-child,
  .menu-toggle:focus-visible .menu-toggle-icon span:last-child {
    transform: translateX(0.2rem);
  }

  .menu-toggle:focus-visible,
  .site-header .brand:focus-visible {
    outline: 3px solid var(--color-clay);
    outline-offset: 5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .menu-toggle,
    .menu-toggle-icon span {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 38rem) {
    .site-header .header-inner {
      width: min(100% - 2rem, 72rem);
      min-height: 5.4rem;
    }

    .site-header .brand {
      gap: 0.7rem;
    }

    .site-header .brand-name-main {
      font-size: 1.05rem;
    }

    .site-header .brand-mark {
      width: 3rem;
      height: 3.1rem;
    }

    .menu-toggle {
      gap: 0.55rem;
      padding-inline: 0.75rem;
      font-size: 0.76rem;
    }

    .menu-toggle-icon {
      width: 1.15rem;
    }
  }

  @media (min-width: 72rem) {
    .menu-toggle {
      display: none;
    }
  }
</style>
