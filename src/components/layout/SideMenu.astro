---
import { navigationGroups } from '../../data/navigation';
import { PUBLIC_BALL_GAME_ENABLED } from 'astro:env/client';

const currentPath = Astro.url.pathname;
const visibleNavigationGroups = navigationGroups
  .map((group) => ({
    ...group,
    links: group.links.filter((link) => PUBLIC_BALL_GAME_ENABLED || link.href !== '/juego/'),
  }))
  .filter((group) => group.links.length > 0);
---

<button
  class="menu-backdrop"
  type="button"
  data-menu-backdrop
  hidden
  aria-label="Cerrar menú"
></button>

<aside class="side-menu" id="site-menu" aria-label="Menú lateral" aria-hidden="true" inert>
  <div class="side-menu-inner">
    <div class="side-menu-header">
      <div class="menu-brand">
        <img
          class="menu-crest"
          src="/brand/escudo-palomares-del-campo.svg"
          alt=""
          aria-hidden="true"
          width="32"
          height="56"
        />
        <p class="menu-kicker">Palomares del Campo</p>
      </div>
      <button class="menu-close" type="button" data-menu-close aria-label="Cerrar menú">
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <div class="side-menu-content">
      <nav aria-label="Secciones del sitio">
        <div class="side-nav-groups">
          {currentPath !== '/' && (
            <ul class="side-nav side-nav--home">
              <li>
                <a href="/">Inicio</a>
              </li>
            </ul>
          )}
          {visibleNavigationGroups.map((group) => (
            <section class="side-nav-group" aria-labelledby={`menu-group-${group.label}`}>
              <h2 id={`menu-group-${group.label}`}>{group.label}</h2>
              <ul class="side-nav">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={
                        currentPath === link.href
                          ? 'page'
                          : currentPath.startsWith(link.href)
                            ? 'location'
                            : undefined
                      }
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </nav>

      <div class="menu-visual">
        <canvas id="menu-scene" aria-hidden="true"></canvas>
        <div class="menu-visual-copy">
          <span class="visual-pulse" aria-hidden="true"></span>
          <p>El paisaje también puede moverse.</p>
          <small>Una primera coordenada para lo que viene.</small>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  import '../../scripts/menu.ts';
</script>

<style is:global>
  body.menu-is-open {
    overflow: hidden;
  }

  .menu-backdrop {
    position: fixed;
    z-index: 1200;
    inset: 0;
    width: 100%;
    border: 0;
    background: rgb(13 29 25 / 52%);
    cursor: pointer;
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .menu-backdrop:not([hidden]) {
    opacity: 1;
  }

  .side-menu {
    position: fixed;
    z-index: 1300;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100%, 31rem);
    overflow-y: auto;
    color: var(--color-surface-soft);
    background: var(--color-ink);
    box-shadow: -1.5rem 0 4rem rgb(13 29 25 / 18%);
    transform: translateX(102%);
    transition: transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .side-menu.is-open {
    transform: translateX(0);
  }

  .side-menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 1.5rem clamp(1.5rem, 5vw, 3rem) 2rem;
  }

  .side-menu-header {
    position: sticky;
    z-index: 2;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: -1.5rem;
    padding: 1.5rem 0 1rem;
    background: var(--color-ink);
    box-shadow: 0 1px 0 rgb(239 245 237 / 10%);
  }

  .menu-kicker {
    margin: 0;
    color: var(--color-ochre);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .menu-brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.8rem;
  }

  .menu-crest {
    display: none;
    flex: 0 0 auto;
    width: 2rem;
    height: 3.5rem;
    object-fit: contain;
  }

  .menu-close {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgb(239 245 237 / 22%);
    border-radius: 50%;
    color: var(--color-surface-soft);
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-size: 1.8rem;
    font-weight: 300;
    line-height: 1;
  }

  .menu-close:hover,
  .menu-close:focus-visible {
    border-color: var(--color-ochre);
    color: var(--color-ochre);
  }

  .side-menu-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding: clamp(4rem, 13vh, 8rem) 0 1rem;
  }

  .side-nav-groups {
    display: grid;
    gap: 2rem;
  }

  .side-nav-group h2 {
    margin: 0 0 0.45rem;
    color: var(--color-ochre);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .side-nav {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side-nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.65rem 0;
    color: var(--color-surface-soft);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 3.2rem);
    letter-spacing: -0.045em;
    line-height: 1;
    text-decoration: none;
  }

  .side-nav a:hover,
  .side-nav a:focus-visible {
    color: var(--color-ochre);
  }

  .side-nav a[aria-current] {
    color: var(--color-ochre);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
  }

  .menu-visual {
    position: relative;
    min-height: 15rem;
    overflow: hidden;
    border: 1px solid rgb(239 245 237 / 14%);
    border-radius: 1.5rem;
    background: radial-gradient(
      circle at 52% 38%,
      var(--color-forest) 0%,
      var(--color-night-panel) 42%,
      var(--color-night) 100%
    );
  }

  #menu-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .menu-visual::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 25%, rgb(13 29 25 / 72%) 100%);
    content: '';
    pointer-events: none;
  }

  .menu-visual-copy {
    position: absolute;
    z-index: 1;
    right: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
  }

  .menu-visual-copy p,
  .menu-visual-copy small {
    display: block;
    margin: 0;
  }

  .menu-visual-copy p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .menu-visual-copy small {
    margin-top: 0.35rem;
    color: var(--color-sage-light);
    font-size: 0.75rem;
  }

  .visual-pulse {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-ochre);
    box-shadow: 0 0 0 0.3rem rgb(229 183 126 / 16%);
  }

  @media (prefers-reduced-motion: reduce) {
    .side-menu,
    .menu-backdrop {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 38rem) {
    .side-menu-inner {
      padding-right: 1.25rem;
      padding-left: 1.25rem;
    }

    .side-nav a {
      font-size: clamp(1.5rem, 6vw, 1.75rem);
    }
  }

  @media (min-width: 72rem) {
    body {
      --desktop-menu-width: 21rem;
      padding-right: var(--desktop-menu-width);
    }

    .menu-backdrop,
    .menu-visual,
    .menu-close {
      display: none;
    }

    .side-menu {
      width: var(--desktop-menu-width);
      transform: none;
      box-shadow: -1rem 0 3rem rgb(13 29 25 / 12%);
    }

    .side-menu-inner {
      padding: 1.5rem 1.75rem;
    }

    .menu-crest {
      display: block;
    }

    .side-menu-content {
      justify-content: flex-start;
      gap: 2rem;
      padding-top: 2.25rem;
    }

    .side-nav-groups {
      gap: 1.25rem;
    }

    .side-nav a {
      gap: 0.75rem;
      padding: 0.5rem 0;
      font-size: clamp(1.1rem, 1.4vw, 1.3rem);
      letter-spacing: -0.025em;
      line-height: 1.2;
    }
  }
</style>
