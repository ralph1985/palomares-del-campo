---
import GameStatusPanel from './GameStatusPanel.astro';
---

<section
  class="game-map-section"
  aria-labelledby="game-map-title"
  data-convex-url={import.meta.env.CONVEX_URL ?? ''}
>
  <div class="game-map-heading">
    <div>
      <p class="eyebrow">Mapa de juego</p>
      <h2 id="game-map-title">La bola está en el pueblo.</h2>
      <p class="game-map-intro">
        Acércate a la coordenada activa, comprueba tu posición y prueba la captura. El ranking y la
        bola compartida se actualizan mediante Convex cuando el backend está configurado.
      </p>
    </div>
    <span class="prototype-badge">Multijugador en desarrollo</span>
  </div>

  <div class="game-map-layout">
    <div class="map-card">
      <div class="map-hud" aria-label="Estado del tablero">
        <span class="map-hud-live">
          <span aria-hidden="true"></span>En directo
        </span>
        <span data-game-ball-version>Bola activa · versión local</span>
      </div>
      <div
        id="game-map"
        class="game-map"
        role="application"
        aria-label="Mapa interactivo de Palomares del Campo con lugares de juego"
      ></div>
      <div class="map-attribution-note">
        Mapa ©{' '}
        <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">
          OpenStreetMap
        </a>
      </div>
    </div>

    <GameStatusPanel />
  </div>
</section>

<script>
  import '../../scripts/game-map.ts';
</script>

<style>
  :global(.game-ball-icon-wrapper),
  :global(.game-user-icon-wrapper) {
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
  }

  :global(.game-ball-icon) {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    border: 3px solid #eff5ed;
    border-radius: 50%;
    background: #a05c32;
    box-shadow:
      0 0 0 0.35rem rgb(160 92 50 / 24%),
      0 0.3rem 0.8rem rgb(25 52 45 / 35%);
    animation: game-ball-pulse 1.8s ease-in-out infinite;
  }

  :global(.game-user-icon) {
    display: block;
    width: 0.9rem;
    height: 0.9rem;
    border: 3px solid #eff5ed;
    border-radius: 50%;
    background: #2f6652;
    box-shadow: 0 0 0 0.25rem rgb(47 102 82 / 24%);
  }

  @keyframes game-ball-pulse {
    0%,
    100% {
      transform: scale(0.92);
    }

    50% {
      transform: scale(1.08);
    }
  }

  .game-map-section {
    width: min(100% - 2rem, 80rem);
    margin: 2rem auto 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    overflow: hidden;
    border: 1px solid rgb(239 245 237 / 12%);
    border-radius: 2rem;
    color: #eff5ed;
    background: radial-gradient(circle at 90% 0%, rgb(47 102 82 / 22%), transparent 30rem), #10231f;
    box-shadow: 0 2rem 5rem rgb(16 35 31 / 24%);
  }

  .game-map-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #e5b77e;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2,
  h3 {
    margin: 0;
    color: #eff5ed;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  h2 {
    max-width: 13ch;
    color: #eff5ed;
    font-size: clamp(2.3rem, 5vw, 4.2rem);
  }

  .game-map-intro {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: #a9cbb6;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .prototype-badge {
    flex: none;
    padding: 0.55rem 0.75rem;
    border: 1px solid rgb(229 183 126 / 42%);
    border-radius: 999px;
    color: #e5b77e;
    background: rgb(229 183 126 / 7%);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .game-map-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(19rem, 0.75fr);
    gap: 1rem;
  }

  .map-card {
    position: relative;
    min-height: 39rem;
    overflow: hidden;
    border: 1px solid rgb(239 245 237 / 14%);
    border-radius: 1.25rem;
    background: #dce8dc;
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 18%);
  }

  .game-map {
    width: 100%;
    height: 100%;
    min-height: 39rem;
  }

  .map-hud {
    position: absolute;
    z-index: 500;
    top: 0.85rem;
    right: 0.85rem;
    left: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid rgb(25 52 45 / 14%);
    border-radius: 0.65rem;
    color: #19342d;
    background: rgb(244 241 233 / 90%);
    box-shadow: 0 0.5rem 1rem rgb(25 52 45 / 12%);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .map-hud-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #2f6652;
  }

  .map-hud-live span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #3f9b69;
    box-shadow: 0 0 0 0.25rem rgb(63 155 105 / 16%);
  }

  .map-attribution-note {
    position: absolute;
    z-index: 500;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.25rem 0.45rem;
    border-radius: 0.35rem;
    color: #19342d;
    background: rgb(244 241 233 / 88%);
    font-size: 0.65rem;
  }

  .map-attribution-note a {
    color: inherit;
  }

  @media (max-width: 58rem) {
    .game-map-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .game-map-section {
      width: min(100% - 2rem, 72rem);
    }

    .game-map-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .map-card,
    .game-map {
      min-height: 27rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-button,
    :global(.game-ball-icon) {
      transition-duration: 0.01ms;
      animation: none;
    }
  }
</style>
