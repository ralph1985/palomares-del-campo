---
import GameStatusPanel from './GameStatusPanel.astro';
const hasRemoteGame = Boolean(import.meta.env.CONVEX_URL);
---

<section
  class="game-map-section"
  aria-labelledby="game-map-title"
  data-convex-url={import.meta.env.CONVEX_URL ?? ''}
>
  <div class="game-map-heading">
    <div>
      <p class="eyebrow">01 / Tablero de juego</p>
      <h2 id="game-map-title">Encuentra el punto activo.</h2>
      <p class="game-map-intro">
        Acércate al objetivo, comprueba tu posición y captura antes que los demás. El ranking y la
        bola compartida se actualizan en directo.
      </p>
    </div>
    <span class="prototype-badge">
      <span aria-hidden="true"></span>
      {hasRemoteGame ? 'Multijugador en directo' : 'Modo local de prueba'}
    </span>
  </div>

  <div class="game-map-layout">
    <div class="map-card">
      <div class="map-hud" aria-label="Estado del tablero">
        <span class="map-hud-live">
          <span aria-hidden="true"></span>En directo
        </span>
        <span data-game-ball-version>Bola activa · versión local</span>
        <button
          class="game-immersive-toggle"
          type="button"
          data-game-immersive-toggle
          aria-pressed="false"
        >
          <span aria-hidden="true">⛶</span>
          <span data-game-immersive-label>Inmersivo</span>
        </button>
      </div>
      <div
        id="game-map"
        class="game-map"
        role="application"
        aria-label="Mapa interactivo de Palomares del Campo con lugares de juego"
      ></div>
      <div class="map-attribution-note">
        Mapa ©{' '}
        <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">
          OpenStreetMap
        </a>
      </div>
    </div>

    <GameStatusPanel />
  </div>
</section>

<script>
  import '../../scripts/game-map.ts';
</script>

<style>
  :global(.game-ball-icon-wrapper),
  :global(.game-user-icon-wrapper) {
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
  }

  :global(.game-ball-icon) {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    border: 3px solid #eff5ed;
    border-radius: 50%;
    background: #a05c32;
    box-shadow:
      0 0 0 0.35rem rgb(160 92 50 / 24%),
      0 0.3rem 0.8rem rgb(25 52 45 / 35%);
    animation: game-ball-pulse 1.8s ease-in-out infinite;
  }

  :global(.game-user-icon) {
    display: block;
    width: 0.9rem;
    height: 0.9rem;
    border: 3px solid #eff5ed;
    border-radius: 50%;
    background: #2f6652;
    box-shadow: 0 0 0 0.25rem rgb(47 102 82 / 24%);
  }

  @keyframes game-ball-pulse {
    0%,
    100% {
      transform: scale(0.92);
    }

    50% {
      transform: scale(1.08);
    }
  }

  .game-map-section {
    position: relative;
    z-index: 0;
    isolation: isolate;
    width: min(100% - 2rem, 80rem);
    margin: 1rem auto 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    overflow: hidden;
    border: 1px solid rgb(239 245 237 / 12%);
    border-radius: 2rem;
    color: #eff5ed;
    background: radial-gradient(circle at 90% 0%, rgb(47 102 82 / 22%), transparent 30rem), #10231f;
    box-shadow: 0 2rem 5rem rgb(16 35 31 / 24%);
  }

  .game-map-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #e5b77e;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2,
  h3 {
    margin: 0;
    color: #eff5ed;
    font-family: inherit;
    font-weight: 850;
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  h2 {
    max-width: 13ch;
    color: #eff5ed;
    font-size: clamp(2.3rem, 5vw, 4.2rem);
  }

  .game-map-intro {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: #a9cbb6;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .prototype-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    padding: 0.55rem 0.75rem;
    border: 1px solid rgb(229 183 126 / 42%);
    border-radius: 999px;
    color: #e5b77e;
    background: rgb(229 183 126 / 7%);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .prototype-badge::before {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: #e5b77e;
    box-shadow: 0 0 0 0.2rem rgb(229 183 126 / 12%);
    content: '';
  }

  .game-map-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(19rem, 0.75fr);
    gap: 1rem;
  }

  .map-card {
    position: relative;
    min-height: 39rem;
    overflow: hidden;
    border: 1px solid rgb(239 245 237 / 14%);
    border-radius: 1.25rem;
    background: #dce8dc;
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 18%);
  }

  .game-map {
    width: 100%;
    height: 100%;
    min-height: 39rem;
  }

  .map-hud {
    position: absolute;
    z-index: 500;
    top: 0.85rem;
    right: 0.85rem;
    left: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid rgb(25 52 45 / 14%);
    border-radius: 0.65rem;
    color: #19342d;
    background: rgb(244 241 233 / 90%);
    box-shadow: 0 0.5rem 1rem rgb(25 52 45 / 12%);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .map-hud-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #2f6652;
  }

  .map-hud-live span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #3f9b69;
    box-shadow: 0 0 0 0.25rem rgb(63 155 105 / 16%);
  }

  .game-immersive-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 1.9rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid rgb(25 52 45 / 22%);
    border-radius: 0.45rem;
    color: #19342d;
    background: rgb(255 255 255 / 44%);
    cursor: pointer;
    font: inherit;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .game-immersive-toggle:hover,
  .game-immersive-toggle[aria-pressed='true'] {
    color: #eff5ed;
    background: #19342d;
  }

  .game-immersive-toggle:focus-visible {
    outline: 3px solid #e5b77e;
    outline-offset: 2px;
  }

  .map-attribution-note {
    position: absolute;
    z-index: 500;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.25rem 0.45rem;
    border-radius: 0.35rem;
    color: #19342d;
    background: rgb(244 241 233 / 88%);
    font-size: 0.65rem;
  }

  .map-attribution-note a {
    color: inherit;
  }

  :global(body.game-immersive-mode) {
    overflow: hidden;
  }

  :global(body.game-immersive-mode main) {
    position: fixed;
    z-index: 0;
    top: var(--game-header-height, 4rem);
    right: 0;
    bottom: 0;
    left: 0;
    height: auto;
    overflow: hidden;
  }

  :global(body.game-immersive-mode .game-hero),
  :global(body.game-immersive-mode .game-rules),
  :global(body.game-immersive-mode .site-footer) {
    display: none;
  }

  :global(body.game-immersive-mode .game-map-section) {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  :global(body.game-immersive-mode .game-map-heading) {
    position: absolute;
    z-index: 650;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  :global(body.game-immersive-mode .game-map-layout) {
    display: block;
    height: 100%;
  }

  :global(body.game-immersive-mode .map-card),
  :global(body.game-immersive-mode .game-map) {
    height: 100%;
    min-height: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  :global(body.game-immersive-mode .map-hud) {
    top: 1rem;
    right: 1rem;
    left: 1rem;
    z-index: 700;
  }

  :global(body.game-immersive-mode .game-panel) {
    position: absolute;
    z-index: 700;
    top: 4.5rem;
    right: 1rem;
    bottom: 1rem;
    width: min(18rem, calc(100% - 2rem));
    max-height: calc(100% - 5.5rem);
    min-height: 0;
    overflow: auto;
    margin: 0;
    padding: 0.9rem;
    border-color: rgb(239 245 237 / 24%);
    background: rgb(16 35 31 / 88%);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 30%);
    backdrop-filter: blur(1rem);
  }

  :global(body.game-immersive-mode .game-location-description) {
    display: none;
  }

  :global(body.game-immersive-mode .game-panel h3) {
    margin: 0.35rem 0 0;
    font-size: 1.35rem;
    line-height: 1.05;
  }

  :global(body.game-immersive-mode .is-connected .game-player-form) {
    display: none;
  }

  :global(body.game-immersive-mode .game-panel-topline) {
    font-size: 0.62rem;
  }

  :global(body.game-immersive-mode .game-panel .game-actions) {
    margin-top: 0.6rem;
  }

  :global(body.game-immersive-mode .game-panel .game-feedback) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(body.game-immersive-mode .game-player-form) {
    margin-top: 0.7rem;
    padding: 0.7rem;
  }

  :global(body.game-immersive-mode .game-stats) {
    gap: 0.4rem;
    margin-top: 0.7rem;
  }

  :global(body.game-immersive-mode .game-stats > div),
  :global(body.game-immersive-mode .location-readout) {
    padding: 0.6rem;
  }

  :global(body.game-immersive-mode .location-readout) {
    margin-top: 0.4rem;
  }

  :global(body.game-immersive-mode .game-actions) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
    margin-top: 0.7rem;
  }

  :global(body.game-immersive-mode .game-actions .game-button) {
    min-height: 2.45rem;
    padding: 0.55rem 0.6rem;
    font-size: 0.72rem;
  }

  :global(body.game-immersive-mode .game-stats),
  :global(body.game-immersive-mode .location-readout),
  :global(body.game-immersive-mode .game-ranking),
  :global(body.game-immersive-mode .game-simulator) {
    display: none;
  }

  :global(body.game-immersive-mode .game-actions [data-game-check]) {
    display: none;
  }

  :global(body.game-immersive-mode .game-feedback) {
    min-height: 0;
    margin: 0.55rem 0 0;
    font-size: 0.72rem;
  }

  :global(body.game-immersive-mode .game-ranking) {
    padding-top: 0.75rem;
  }

  :global(body.game-immersive-mode .game-ranking-list) {
    gap: 0.3rem;
    margin-top: 0.55rem;
  }

  :global(body.game-immersive-mode .game-ranking-entry) {
    min-height: 2.15rem;
    padding: 0.3rem 0.4rem;
    font-size: 0.72rem;
  }

  @media (max-width: 58rem) {
    .game-map-layout {
      grid-template-columns: 1fr;
    }

    :global(body.game-immersive-mode .game-panel) {
      top: auto;
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
      width: auto;
      max-height: min(52svh, 34rem);
    }
  }

  @media (max-width: 38rem) {
    .game-map-section {
      width: min(100% - 2rem, 72rem);
    }

    .game-map-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .map-card,
    .game-map {
      min-height: 27rem;
    }

    .map-hud {
      flex-wrap: wrap;
    }

    .map-hud > [data-game-ball-version] {
      flex: 1 1 auto;
      min-width: 8rem;
    }

    :global(body.game-immersive-mode .map-hud) {
      align-items: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-button,
    :global(.game-ball-icon) {
      transition-duration: 0.01ms;
      animation: none;
    }
  }
</style>
