---
import GameStatusPanel from './GameStatusPanel.astro';
---

<section
  class="game-map-section"
  aria-labelledby="game-map-title"
  data-convex-url={import.meta.env.CONVEX_URL ?? ''}
>
  <div class="game-map-heading">
    <div>
      <p class="eyebrow">Mapa de juego</p>
      <h2 id="game-map-title">La bola está en el pueblo.</h2>
      <p class="game-map-intro">
        Acércate a la coordenada activa, comprueba tu posición y prueba la captura. Esta versión
        funciona solo en tu navegador: todavía no hay jugadores ni ranking real.
      </p>
    </div>
    <span class="prototype-badge">Prototipo local</span>
  </div>

  <div class="game-map-layout">
    <div class="map-card">
      <div
        id="game-map"
        class="game-map"
        role="application"
        aria-label="Mapa interactivo de Palomares del Campo con lugares de juego"
      ></div>
      <div class="map-attribution-note">
        Mapa ©{' '}
        <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">
          OpenStreetMap
        </a>
      </div>
    </div>

    <GameStatusPanel />
  </div>
</section>

<script>
  import '../../scripts/game-map.ts';
</script>

<style>
  :global(.game-ball-icon-wrapper),
  :global(.game-user-icon-wrapper) {
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
  }

  :global(.game-ball-icon) {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    border: 3px solid #eff5ed;
    border-radius: 50%;
    background: #a05c32;
    box-shadow:
      0 0 0 0.35rem rgb(160 92 50 / 24%),
      0 0.3rem 0.8rem rgb(25 52 45 / 35%);
    animation: game-ball-pulse 1.8s ease-in-out infinite;
  }

  :global(.game-user-icon) {
    display: block;
    width: 0.9rem;
    height: 0.9rem;
    border: 3px solid #eff5ed;
    border-radius: 50%;
    background: #2f6652;
    box-shadow: 0 0 0 0.25rem rgb(47 102 82 / 24%);
  }

  @keyframes game-ball-pulse {
    0%,
    100% {
      transform: scale(0.92);
    }

    50% {
      transform: scale(1.08);
    }
  }

  .game-map-section {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
    padding: clamp(4rem, 9vw, 8rem) 0;
  }

  .game-map-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #a05c32;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2,
  h3 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  h2 {
    max-width: 11ch;
    color: #19342d;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
  }

  .game-map-intro {
    max-width: 39rem;
    margin: 1.5rem 0 0;
    color: #527066;
    line-height: 1.65;
  }

  .prototype-badge {
    flex: none;
    padding: 0.55rem 0.8rem;
    border: 1px solid rgb(160 92 50 / 30%);
    border-radius: 999px;
    color: #a05c32;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .game-map-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 0.75fr);
    gap: 1rem;
  }

  .map-card {
    position: relative;
    min-height: 35rem;
    overflow: hidden;
    border: 1px solid rgb(25 52 45 / 13%);
    border-radius: 1.5rem;
    background: #dce8dc;
    box-shadow: 0 1.5rem 3rem rgb(25 52 45 / 8%);
  }

  .game-map {
    width: 100%;
    height: 100%;
    min-height: 35rem;
  }

  .map-attribution-note {
    position: absolute;
    z-index: 500;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.25rem 0.45rem;
    border-radius: 0.35rem;
    color: #19342d;
    background: rgb(244 241 233 / 88%);
    font-size: 0.65rem;
  }

  .map-attribution-note a {
    color: inherit;
  }

  @media (max-width: 58rem) {
    .game-map-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .game-map-section {
      width: min(100% - 2rem, 72rem);
    }

    .game-map-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .map-card,
    .game-map {
      min-height: 27rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-button,
    :global(.game-ball-icon) {
      transition-duration: 0.01ms;
      animation: none;
    }
  }
</style>
