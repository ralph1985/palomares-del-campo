---
<div class="game-ball-visual" data-game-ball aria-hidden="true">
  <span class="game-ball-fallback"></span>
  <canvas data-game-ball-canvas></canvas>
</div>
<script>
  import '../../scripts/game-ball.ts';
</script>
<style>
  .game-ball-visual {
    position: relative;
    width: min(9rem, 48vw);
    aspect-ratio: 1;
    margin: 1rem 0 0 auto;
    opacity: 0.94;
    pointer-events: none;
  }

  .game-ball-fallback,
  .game-ball-visual canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .game-ball-fallback {
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 25%, var(--color-night-soft) 0 4%, transparent 18%),
      radial-gradient(
        circle at 38% 34%,
        var(--color-ochre) 0 18%,
        var(--color-game-marker) 68%,
        var(--color-night) 100%
      );
    box-shadow:
      inset -0.8rem -1rem 1.3rem var(--color-night),
      0 1.4rem 2rem var(--color-ink);
    transform: rotate(-12deg);
  }

  .game-ball-fallback::after {
    position: absolute;
    inset: 12%;
    border: 1px solid var(--color-game-ball-ring);
    border-radius: 50%;
    content: '';
    transform: rotate(32deg) scaleY(0.58);
  }

  .game-ball-visual canvas {
    opacity: 0;
    transition: opacity 420ms ease;
  }

  .game-ball-visual.is-ready canvas {
    opacity: 1;
  }

  .game-ball-visual.is-ready .game-ball-fallback {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .game-ball-visual canvas {
      transition: none;
    }
  }
</style>
