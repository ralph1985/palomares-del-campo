---
---

<section class="game-ranking" aria-labelledby="game-ranking-title">
  <div class="game-ranking-heading">
    <div>
      <span class="stat-label">Puntuación compartida</span>
      <h4 id="game-ranking-title">Ranking de la partida</h4>
    </div>
    <span class="game-ranking-status" data-game-ranking-status role="status">
      Conectando…
    </span>
  </div>
  <ol class="game-ranking-list" data-game-ranking aria-live="polite"></ol>
  <p class="game-ranking-empty" data-game-ranking-empty>
    Aún no hay jugadores con puntos.
  </p>
</section>

<style>
  .game-ranking {
    margin-top: auto;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-game-panel-divider);
  }

  .game-ranking-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .game-ranking h4 {
    margin: 0.2rem 0 0;
    color: var(--color-surface-soft);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: var(--font-weight-medium);
  }

  .game-ranking-status {
    color: var(--color-sage-light);
    font-size: var(--font-size-label);
  }

  .game-ranking-list {
    display: grid;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  :global(.game-ranking-entry) {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.65rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--color-game-ranking-border);
    border-radius: 0.7rem;
    background: var(--color-game-ranking-surface);
    font-size: 0.82rem;
  }

  :global(.game-ranking-entry:first-child) {
    border: 1px solid var(--color-game-ranking-top-border);
    background: linear-gradient(
      100deg,
      var(--color-game-ranking-top-start),
      var(--color-game-ranking-top-end)
    );
  }

  :global(.game-ranking-entry[data-current]) {
    box-shadow: inset 0 0 0 1px var(--color-game-ranking-current);
  }

  :global(.game-ranking-entry[data-current]::after) {
    content: 'Tú';
    color: var(--color-night-text);
    font-size: 0.62rem;
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.game-ranking-position) {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 1px solid var(--color-game-ranking-position-border);
    border-radius: 50%;
    color: var(--color-ochre);
    background: var(--color-game-ranking-position-surface);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.game-ranking-nickname) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.game-ranking-score) {
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--color-game-ranking-score-border);
    border-radius: 0.45rem;
    color: var(--color-ochre);
    background: var(--color-game-ranking-position-surface);
    font-size: var(--font-size-label);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-weight-strong);
  }

  .game-ranking-empty {
    margin: 0.8rem 0 0;
    color: var(--color-sage-light);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  @media (max-width: 58rem) {
    .game-ranking-list {
      gap: 0.3rem;
    }
  }
</style>
