---
import { gameLocations } from '../../data/game-locations';
import Button from '../ui/Button.astro';
---

<aside class="game-panel" aria-labelledby="game-status-title">
  <div class="game-panel-topline">
    <span class="status-dot" aria-hidden="true"></span>
    <span data-game-mode-label>Partida local</span>
  </div>
  <h3 id="game-status-title" data-game-location-name>
    Plaza del Coso
  </h3>
  <p class="game-location-description" data-game-location-description>
    El corazón del pueblo para empezar la partida.
  </p>

  <form class="game-player-form" data-game-player-form>
    <label for="game-nickname">Tu nick</label>
    <div class="game-player-input-row">
      <input
        id="game-nickname"
        name="nickname"
        type="text"
        maxlength="24"
        autocomplete="nickname"
        placeholder="Ej. Pájaro Verde"
        data-game-nickname
        required
      />
      <Button variant="secondary" type="submit" data-game-join>
        Entrar
      </Button>
    </div>
    <p class="game-player-feedback" data-game-player-feedback role="status">
      Elige un nick para entrar en la partida.
    </p>
  </form>

  <div class="game-stats" aria-label="Estado de la partida">
    <div>
      <span class="stat-label">Tus puntos</span>
      <strong data-game-score>0</strong>
    </div>
    <div>
      <span class="stat-label">Capturas</span>
      <strong data-game-captures>0</strong>
    </div>
    <div>
      <span class="stat-label">Radio de captura</span>
      <strong data-game-radius>55 m</strong>
    </div>
  </div>

  <div class="location-readout" aria-live="polite">
    <span class="stat-label">Tu posición</span>
    <strong data-game-distance>Aún no comprobada</strong>
    <small data-game-accuracy>La ubicación no se comparte en este prototipo.</small>
  </div>

  <div class="game-actions">
    <Button variant="primary" type="button" data-game-locate>
      Obtener ubicación
    </Button>
    <Button variant="secondary" type="button" data-game-check disabled>
      Comprobar posición
    </Button>
    <Button variant="capture" type="button" data-game-capture disabled>
      Capturar bola <span aria-hidden="true">+10</span>
    </Button>
  </div>

  <p class="game-feedback" data-game-feedback role="status">
    Pulsa «Obtener ubicación» cuando estés preparado.
  </p>

  {import.meta.env.DEV && (
    <div class="game-simulator" aria-labelledby="simulator-title">
      <span class="stat-label" id="simulator-title">
        Simulador de desarrollo
      </span>
      <select data-game-simulator aria-label="Elegir ubicación simulada">
        <option value="">Elegir un punto del mapa</option>
        {gameLocations.map((location) => (
          <option value={location.id}>{location.shortName}</option>
        ))}
      </select>
      <select data-game-scenario aria-label="Elegir escenario de posición simulada">
        <option value="exact">Posición exacta</option>
        <option value="edge">Cerca del límite</option>
        <option value="outside">Fuera del radio</option>
        <option value="low-accuracy">Precisión insuficiente</option>
      </select>
      <Button variant="simulator" type="button" data-game-simulate disabled>
        Simular posición
      </Button>
    </div>
  )}

  <section class="game-ranking" aria-labelledby="game-ranking-title">
    <div class="game-ranking-heading">
      <div>
        <span class="stat-label">Puntuación compartida</span>
        <h4 id="game-ranking-title">Ranking de la partida</h4>
      </div>
      <span class="game-ranking-status" data-game-ranking-status role="status">
        Conectando…
      </span>
    </div>
    <ol class="game-ranking-list" data-game-ranking aria-live="polite"></ol>
    <p class="game-ranking-empty" data-game-ranking-empty>
      Aún no hay jugadores con puntos.
    </p>
  </section>
</aside>

<style>
  .game-panel {
    position: sticky;
    top: 1rem;
    display: flex;
    align-self: start;
    flex-direction: column;
    min-height: 39rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid rgb(239 245 237 / 12%);
    border-radius: 1.25rem;
    color: var(--color-surface-soft);
    background: linear-gradient(155deg, rgb(47 102 82 / 23%), transparent 40%), var(--color-ink);
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 18%);
  }

  .game-panel-topline {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-sage-light);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-ochre);
    box-shadow: 0 0 0 0.3rem rgb(229 183 126 / 16%);
  }

  .game-panel h3 {
    margin: 2rem 0 0;
    color: var(--color-surface-soft);
    font-family: inherit;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: var(--font-weight-display);
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  .game-location-description {
    min-height: 3.2rem;
    margin: 1rem 0 0;
    color: var(--color-sage-light);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .game-player-form {
    margin-top: 1.25rem;
    padding: 0.9rem;
    border: 1px solid rgb(239 245 237 / 13%);
    border-radius: 0.8rem;
    background: rgb(239 245 237 / 5%);
  }

  .game-player-form label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-sage-light);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .game-player-input-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
  }

  .game-player-input-row input {
    min-width: 0;
    min-height: 3rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid rgb(239 245 237 / 28%);
    border-radius: 0.7rem;
    color: var(--color-surface-soft);
    background: rgb(0 0 0 / 14%);
    font: inherit;
  }

  .game-player-input-row input:focus-visible {
    outline: 3px solid var(--color-ochre);
    outline-offset: 2px;
  }

  .game-player-feedback {
    min-height: 1.2rem;
    margin: 0.55rem 0 0;
    color: var(--color-sage-light);
    font-size: var(--font-size-label);
    line-height: 1.4;
  }

  .game-player-feedback[data-state='error'] {
    color: var(--color-night-highlight);
  }

  .game-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .game-stats > div,
  .location-readout {
    padding: 0.85rem;
    border: 1px solid rgb(239 245 237 / 13%);
    border-radius: 0.8rem;
    background: rgb(239 245 237 / 5%);
  }

  .stat-label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--color-night-muted);
    font-size: 0.67rem;
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .game-stats strong {
    font-size: 1.35rem;
  }

  .location-readout {
    margin-top: 0.6rem;
  }

  .location-readout strong {
    display: block;
    font-size: 0.95rem;
  }

  .location-readout small {
    display: block;
    margin-top: 0.45rem;
    color: var(--color-sage-light);
    font-size: var(--font-size-label);
    line-height: 1.45;
  }

  .game-actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .game-feedback {
    min-height: 3.2rem;
    margin: 1rem 0 0;
    color: var(--color-ochre);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .game-simulator {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.5rem;
    padding: 0.9rem;
    border: 1px dashed rgb(229 183 126 / 48%);
    border-radius: 0.8rem;
    background: rgb(229 183 126 / 7%);
  }

  .game-simulator select {
    width: 100%;
    min-height: 2.7rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgb(239 245 237 / 22%);
    border-radius: 0.55rem;
    color: var(--color-surface-soft);
    background: var(--color-night-panel);
    font: inherit;
    font-size: 0.8rem;
  }

  .game-simulator select:focus-visible {
    outline: 3px solid var(--color-ochre);
    outline-offset: 2px;
  }

  .game-ranking {
    margin-top: auto;
    padding-top: 1.4rem;
    border-top: 1px solid rgb(239 245 237 / 13%);
  }

  .game-ranking-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .game-ranking h4 {
    margin: 0.2rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .game-ranking-status {
    color: var(--color-sage-light);
    font-size: var(--font-size-label);
  }

  .game-ranking-list {
    display: grid;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  :global(.game-ranking-entry) {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.65rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid rgb(239 245 237 / 8%);
    border-radius: 0.7rem;
    background: rgb(239 245 237 / 5%);
    font-size: 0.82rem;
  }

  :global(.game-ranking-entry:first-child) {
    border: 1px solid rgb(229 183 126 / 38%);
    background: linear-gradient(100deg, rgb(229 183 126 / 16%), rgb(239 245 237 / 6%));
  }

  :global(.game-ranking-entry[data-current]) {
    box-shadow: inset 0 0 0 1px rgb(169 220 185 / 38%);
  }

  :global(.game-ranking-entry[data-current]::after) {
    content: 'Tú';
    color: var(--color-night-text);
    font-size: 0.62rem;
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.game-ranking-position) {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 1px solid rgb(229 183 126 / 32%);
    border-radius: 50%;
    color: var(--color-ochre);
    background: rgb(229 183 126 / 8%);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.game-ranking-nickname) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.game-ranking-score) {
    padding: 0.25rem 0.45rem;
    border: 1px solid rgb(229 183 126 / 24%);
    border-radius: 0.45rem;
    color: var(--color-ochre);
    background: rgb(229 183 126 / 8%);
    font-size: var(--font-size-label);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-weight-strong);
  }

  .game-ranking-empty {
    margin: 0.8rem 0 0;
    color: var(--color-sage-light);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  @media (max-width: 38rem) {
    .game-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .game-stats > div:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 58rem) {
    .game-panel {
      min-height: auto;
    }
  }
</style>
