---
import type { HTMLAttributes } from 'astro/types';

export type SiteButtonVariant = 'primary' | 'secondary';

interface Props extends Omit<HTMLAttributes<'button'>, 'type'> {
  type: 'button' | 'submit' | 'reset';
  variant?: SiteButtonVariant;
}

const { type, variant = 'secondary', class: className, ...buttonAttributes } = Astro.props;
---

<button
  {...buttonAttributes}
  type={type}
  class:list={['ui-control', `ui-control-${variant}`, 'site-button', className]}
  data-ui-button
  data-ui-variant={variant}
>
  <slot />
</button>
