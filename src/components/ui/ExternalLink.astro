---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
}

const { href, class: className, ...linkAttributes } = Astro.props;
---

<a
  {...linkAttributes}
  href={href}
  class:list={['ui-external-link', className]}
  data-ui-external-link
  target="_blank"
  rel="noopener noreferrer"
>
  <slot />
</a>

<style is:global>
  .ui-external-link {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .ui-external-link:hover,
  .ui-external-link:focus-visible {
    color: var(--color-clay);
  }
</style>
