---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'target' | 'rel'> {
  href: string;
  newTab?: boolean;
}

const {
  href,
  newTab = false,
  'aria-label': ariaLabel,
  class: className,
  ...linkAttributes
} = Astro.props;
---

<a
  {...linkAttributes}
  href={href}
  class:list={['ui-external-link', className]}
  data-ui-external-link
  aria-label={newTab && ariaLabel ? `${ariaLabel} (se abre en una pestaña nueva)` : ariaLabel}
  {...(newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
  {newTab && !ariaLabel && <span class="ui-visually-hidden"> (se abre en una pestaña nueva)</span>}
</a>

<style is:global>
  .ui-external-link {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .ui-external-link:hover,
  .ui-external-link:focus-visible {
    color: var(--color-clay);
  }
</style>
