---
import type { HTMLAttributes } from 'astro/types';

type ActionLinkVariant = 'text' | 'underline' | 'solid';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
  variant?: ActionLinkVariant;
}

const { href, variant = 'text', class: className, ...linkAttributes } = Astro.props;
---

<a
  {...linkAttributes}
  href={href}
  class:list={['ui-action-link', `ui-action-link-${variant}`, className]}
  data-ui-link
  data-ui-variant={variant}
>
  <slot />
</a>

<style is:global>
  .ui-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: var(--font-weight-strong);
    text-decoration: none;
  }

  .ui-action-link:focus-visible {
    outline: 3px solid var(--color-clay);
    outline-offset: 5px;
  }

  .ui-action-link > span[aria-hidden='true'] {
    transition: transform 180ms ease;
  }

  .ui-action-link:hover > span[aria-hidden='true'],
  .ui-action-link:focus-visible > span[aria-hidden='true'] {
    transform: translateX(0.25rem);
  }

  .ui-action-link-text {
    color: var(--color-forest);
    font-size: var(--font-size-small);
  }

  .ui-action-link-text:hover,
  .ui-action-link-text:focus-visible {
    color: var(--color-clay);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .ui-action-link-underline {
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-clay);
    color: var(--color-clay);
    font-size: var(--font-size-small);
  }

  .ui-action-link-solid {
    padding: 0.75rem 1rem;
    border: 1px solid rgb(229 183 126 / 45%);
    border-radius: 0.55rem;
    color: var(--color-ink);
    background: var(--color-ochre);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
  }

  .ui-action-link-solid:hover,
  .ui-action-link-solid:focus-visible {
    background: var(--color-night-highlight);
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-action-link > span[aria-hidden='true'] {
      transition-duration: 0.01ms;
    }
  }
</style>
