---
import ActionLink from '../ui/ActionLink.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import { footerOfficialLinks } from '../../data/site-footer';

const residentLinks = footerOfficialLinks.filter(({ label }) =>
  ['Sede electrónica', 'Tablón de anuncios', 'Buzón electrónico'].includes(label),
);
---

<section class="audience-section" aria-labelledby="audience-title">
  <div class="audience-shell">
    <div class="audience-heading">
      <p class="audience-eyebrow">Dos formas de entrar</p>
      <h2 id="audience-title">Lo que necesitas, más cerca.</h2>
    </div>

    <div class="audience-grid">
      <article class="audience-card audience-card--resident">
        <p class="audience-card-kicker">Para el día a día</p>
        <h3>Soy vecino</h3>
        <p>
          Encuentra los accesos municipales y la información que necesitas sin perderte entre
          trámites.
        </p>
        <ActionLink variant="solid" href="/#vecinos">
          Información para vecinos <span aria-hidden="true">↓</span>
        </ActionLink>
      </article>

      <article class="audience-card audience-card--visitor">
        <p class="audience-card-kicker">Para venir despacio</p>
        <h3>Descubre Palomares</h3>
        <p>Historia, patrimonio, paisaje y fiestas para conocer el pueblo antes de recorrerlo.</p>
        <ActionLink variant="underline" href="/sobre-el-pueblo/">
          Conocer el pueblo <span aria-hidden="true">→</span>
        </ActionLink>
      </article>
    </div>
  </div>
</section>

<section class="resident-section" id="vecinos" aria-labelledby="resident-title">
  <div class="resident-shell">
    <div>
      <p class="audience-eyebrow">Servicios municipales</p>
      <h2 id="resident-title">Información para vecinos</h2>
    </div>
    <div class="resident-copy">
      <p>
        Los trámites se realizan en los portales oficiales del Ayuntamiento. Desde aquí puedes
        acceder directamente a los servicios más consultados.
      </p>
      <ul class="resident-links">
        {residentLinks.map((link) => (
          <li>
            <ExternalLink href={link.href}>
              {link.label} <span aria-hidden="true">↗</span>
            </ExternalLink>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .audience-section {
    padding: clamp(4.5rem, 10vw, 8rem) 0;
    color: var(--color-ink);
    background: var(--color-sage);
  }

  .audience-shell,
  .resident-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .audience-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }

  .audience-eyebrow,
  .audience-card-kicker {
    margin: 0 0 0.8rem;
    color: var(--color-clay);
    font-size: 0.72rem;
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  h2 {
    max-width: 12ch;
    margin-bottom: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .audience-card {
    display: flex;
    min-height: 22rem;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.5rem;
  }

  .audience-card--resident {
    color: var(--color-surface-soft);
    background: var(--color-ink);
  }

  .audience-card--visitor {
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .audience-card h3 {
    margin-bottom: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .audience-card p:not(.audience-card-kicker) {
    max-width: 26rem;
    margin-bottom: 2rem;
    color: var(--color-sage-light);
    line-height: 1.6;
  }

  .audience-card--visitor p:not(.audience-card-kicker) {
    color: var(--color-muted);
  }

  .audience-card--resident .audience-card-kicker {
    color: var(--color-ochre);
  }

  .resident-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .resident-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 3rem;
  }

  .resident-copy {
    max-width: 34rem;
  }

  .resident-copy > p {
    margin-bottom: 1.5rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .resident-links {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resident-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-ink);
    font-weight: var(--font-weight-strong);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.25em;
  }

  .resident-links a span {
    color: var(--color-clay);
  }

  @media (max-width: 50rem) {
    .audience-heading,
    .resident-shell {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (max-width: 38rem) {
    .audience-shell,
    .resident-shell {
      width: min(100% - 2rem, 72rem);
    }

    .audience-grid {
      grid-template-columns: 1fr;
    }

    .audience-card {
      min-height: 19rem;
    }
  }
</style>
