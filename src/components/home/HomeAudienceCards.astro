---
import ActionLink from '../ui/ActionLink.astro';
---

<section class="audience-section" aria-labelledby="audience-title">
  <div class="audience-shell">
    <div class="audience-heading">
      <p class="audience-eyebrow">Dos formas de entrar</p>
      <h2 id="audience-title">Información para vecinos y visitantes.</h2>
    </div>

    <div class="audience-grid">
      <article class="audience-card audience-card--resident">
        <p class="audience-card-kicker">Para el día a día</p>
        <h3>Soy vecino</h3>
        <p>
          Encuentra los accesos municipales y la información que necesitas sin perderte entre
          trámites.
        </p>
        <ActionLink variant="solid" href="/informacion-practica/">
          Ver servicios municipales <span aria-hidden="true">→</span>
        </ActionLink>
      </article>

      <article class="audience-card audience-card--visitor">
        <p class="audience-card-kicker">Para conocer el pueblo</p>
        <h3>Descubre Palomares</h3>
        <p>Consulta la historia local, el patrimonio, las fiestas y los lugares de interés.</p>
        <ActionLink variant="underline" href="/sobre-el-pueblo/">
          Conocer el pueblo <span aria-hidden="true">→</span>
        </ActionLink>
      </article>
    </div>
  </div>
</section>

<style>
  .audience-section {
    padding: var(--spacing-section-y) 0;
    color: var(--color-ink);
    background: var(--color-sage);
  }

  .audience-shell {
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
  }

  .audience-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }

  .audience-eyebrow,
  .audience-card-kicker {
    margin: 0 0 0.8rem;
    color: var(--color-clay);
    font-size: 0.72rem;
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .audience-eyebrow {
    color: var(--color-clay-text);
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  h2 {
    max-width: 12ch;
    margin-bottom: 0;
    font-family: var(--font-serif);
    font-size: var(--font-size-section-heading);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .audience-card {
    display: flex;
    min-height: 22rem;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.5rem;
  }

  .audience-card--resident {
    color: var(--color-surface-soft);
    background: var(--color-ink);
  }

  .audience-card--visitor {
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .audience-card h3 {
    margin-bottom: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .audience-card p:not(.audience-card-kicker) {
    max-width: 26rem;
    margin-bottom: 2rem;
    color: var(--color-sage-light);
    line-height: 1.6;
  }

  .audience-card--visitor p:not(.audience-card-kicker) {
    color: var(--color-muted);
  }

  .audience-card--resident .audience-card-kicker {
    color: var(--color-ochre);
  }

  @media (max-width: 50rem) {
    .audience-heading {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (max-width: 38rem) {
    .audience-shell {
      width: min(100% - 2rem, 72rem);
    }

    .audience-grid {
      grid-template-columns: 1fr;
    }

    .audience-card {
      min-height: 19rem;
    }
  }
</style>
