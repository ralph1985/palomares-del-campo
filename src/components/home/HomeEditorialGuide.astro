---
import ActionLink from '../ui/ActionLink.astro';
import { homeEditorialEntries } from '../../data/home';
import { PUBLIC_BALL_GAME_ENABLED } from 'astro:env/client';

const visibleEntries = homeEditorialEntries.filter(
  (entry) => PUBLIC_BALL_GAME_ENABLED || entry.accent !== 'game',
);
---

<section class="editorial-section" aria-labelledby="editorial-title">
  <div class="editorial-shell">
    <header class="editorial-heading">
      <p class="editorial-eyebrow">Explora Palomares</p>
      <h2 id="editorial-title">
        ¿Qué quieres <em>consultar?</em>
      </h2>
      <p class="editorial-intro">Conoce el pueblo, consulta sus tradiciones o prueba el juego.</p>
    </header>

    <ul class="editorial-grid">
      {visibleEntries.map((entry, index) => (
        <li class:list={['editorial-item', `editorial-item--${entry.accent}`]}>
          <span class="editorial-index" aria-hidden="true">
            0{index + 1}
          </span>
          <article class="editorial-card">
            <div>
              <p class="editorial-card-kicker">{entry.eyebrow}</p>
              <h3>{entry.title}</h3>
              <p class="editorial-description">{entry.description}</p>
            </div>
            <ActionLink variant="underline" href={entry.href}>
              {entry.linkLabel} <span aria-hidden="true">→</span>
            </ActionLink>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .editorial-section {
    border-top: 1px solid var(--color-border);
    padding: var(--spacing-section-y) 0;
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .editorial-shell {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
    width: min(100% - 2.5rem, 80rem);
    margin: 0 auto;
  }

  .editorial-heading {
    position: sticky;
    top: 2rem;
  }

  .editorial-eyebrow,
  .editorial-card-kicker {
    margin: 0 0 0.8rem;
    color: var(--color-clay);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .editorial-heading h2 {
    max-width: 8ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 4.4vw, 4rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  .editorial-heading h2 em {
    color: var(--color-forest);
    font-weight: var(--font-weight-medium);
  }

  .editorial-intro {
    max-width: 25rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    line-height: var(--line-height-body);
  }

  .editorial-grid {
    position: relative;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .editorial-grid::before {
    position: absolute;
    top: 2.75rem;
    bottom: 2.75rem;
    left: 1.38rem;
    border-left: 1px dashed var(--color-sage-light);
    content: '';
    pointer-events: none;
  }

  .editorial-item {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .editorial-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .editorial-index {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2.8rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-clay);
    background: var(--color-paper);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.08em;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .editorial-item:hover .editorial-index {
    border-color: var(--color-forest);
    color: var(--color-surface-soft);
    background: var(--color-forest);
  }

  .editorial-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 1.5rem;
    align-items: center;
  }

  .editorial-card-kicker {
    margin-bottom: 0.35rem;
    font-size: 0.65rem;
  }

  .editorial-card h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.3vw, 3.25rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .editorial-description {
    max-width: 30rem;
    margin: 0.45rem 0 0;
    color: var(--color-muted);
    font-size: var(--font-size-small);
    line-height: 1.55;
  }

  .editorial-card .ui-action-link {
    align-self: center;
    white-space: nowrap;
  }

  @media (max-width: 50rem) {
    .editorial-shell {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .editorial-heading {
      position: static;
    }

    .editorial-heading h2 {
      max-width: 12ch;
      font-size: clamp(3rem, 9vw, 4.5rem);
    }
  }

  @media (max-width: 38rem) {
    .editorial-shell {
      width: min(100% - 2rem, 72rem);
    }

    .editorial-item {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0.85rem;
      align-items: start;
    }

    .editorial-index {
      width: 2.4rem;
      margin-top: 0.2rem;
    }

    .editorial-grid::before {
      left: 1.18rem;
    }

    .editorial-card {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .editorial-card h3 {
      font-size: 2.1rem;
    }

    .editorial-card .ui-action-link {
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-index {
      transition: none;
    }
  }
</style>
