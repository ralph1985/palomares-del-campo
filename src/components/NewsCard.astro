---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'noticias'>;
}

const { post } = Astro.props;
const { title, description, date, sourceName, category } = post.data;
const formattedDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<article class="news-card">
  <div class="news-card-meta">
    <time datetime={date.toISOString()}>{formattedDate}</time>
    <span aria-hidden="true">·</span>
    <span>{sourceName}</span>
  </div>
  <h3>
    <a href={`/noticias/${post.id}`}>{title}</a>
  </h3>
  <p>{description}</p>
  <div class="news-card-footer">
    <span>{category ?? 'Actualidad'}</span>
    <a class="news-card-link" href={`/noticias/${post.id}`}>
      Leer noticia <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    min-height: 18rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    border: 1px solid rgb(25 52 45 / 14%);
    border-radius: 1.15rem;
    background: #fffdf8;
    box-shadow: 0 0.75rem 2rem rgb(25 52 45 / 7%);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  .news-card:hover {
    transform: translateY(-0.3rem);
    box-shadow: 0 1.2rem 2.5rem rgb(25 52 45 / 12%);
  }

  .news-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: #a05c32;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .news-card h3 {
    margin: 1.25rem 0 0.8rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .news-card h3 a {
    color: #19342d;
    text-decoration: none;
  }

  .news-card h3 a:hover,
  .news-card h3 a:focus-visible {
    color: #a05c32;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .news-card p {
    margin: 0;
    color: #527066;
    line-height: 1.6;
  }

  .news-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: #6e8b7c;
    font-size: 0.78rem;
  }

  .news-card-link {
    color: #2f6652;
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
  }

  .news-card-link:hover,
  .news-card-link:focus-visible {
    color: #a05c32;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .news-card {
      transition: none;
    }
  }
</style>
