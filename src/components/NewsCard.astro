---
import type { CollectionEntry } from 'astro:content';
import CollectionCardMeta from './ui/CollectionCardMeta.astro';

interface Props {
  post: CollectionEntry<'noticias'>;
}

const { post } = Astro.props;
const { title, description, date, sourceName, category } = post.data;
const categoryLabel = category ?? 'Actualidad';
const searchText = `${title} ${description} ${categoryLabel} ${sourceName} ${post.body ?? ''}`;
---

<article
  class="news-card"
  data-news-card
  data-search-text={searchText}
  data-search-category={categoryLabel}
  data-search-year={date.getFullYear()}
>
  <CollectionCardMeta date={date} context={sourceName} />
  <h3>
    <a href={`/noticias/${post.id}`}>{title}</a>
  </h3>
  <p>{description}</p>
  <div class="news-card-footer">
    <span>{categoryLabel}</span>
    <a class="news-card-link" href={`/noticias/${post.id}`}>
      Leer noticia <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    min-height: 18rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    border: 1px solid rgb(25 52 45 / 14%);
    border-radius: 1.15rem;
    background: var(--color-surface);
    box-shadow: 0 0.75rem 2rem rgb(25 52 45 / 7%);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  .news-card[hidden] {
    display: none;
  }

  .news-card:hover {
    transform: translateY(-0.3rem);
    box-shadow: 0 1.2rem 2.5rem rgb(25 52 45 / 12%);
  }

  .news-card h3 {
    margin: 1.25rem 0 0.8rem;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .news-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .news-card h3 a:hover,
  .news-card h3 a:focus-visible {
    color: var(--color-clay);
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .news-card p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .news-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .news-card-link {
    color: var(--color-forest);
    font-weight: var(--font-weight-strong);
    text-decoration: none;
    white-space: nowrap;
  }

  .news-card-link:hover,
  .news-card-link:focus-visible {
    color: var(--color-clay);
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .news-card {
      transition: none;
    }
  }
</style>
