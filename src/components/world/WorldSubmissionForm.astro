<section class="world-form-card" aria-labelledby="world-form-title">
  <div class="world-form-intro">
    <p class="eyebrow">Comparte tu historia</p>
    <h2 id="world-form-title">¿Vives lejos de Palomares?</h2>
    <p>
      Cuéntanos dónde estás y qué vínculo mantienes con el pueblo. Revisaremos la propuesta antes de
      mostrarla en el mapa.
    </p>
  </div>

  <form data-palomarenos-form data-convex-url={import.meta.env.CONVEX_URL ?? ''}>
    <div class="world-form-grid">
      <label>
        <span>Nombre que quieres mostrar</span>
        <input name="displayName" type="text" maxlength="80" required autocomplete="name" />
      </label>
      <label>
        <span>Ciudad</span>
        <input name="city" type="text" maxlength="80" required autocomplete="address-level2" />
      </label>
      <label>
        <span>País</span>
        <input name="country" type="text" maxlength="80" required autocomplete="country-name" />
      </label>
      <label>
        <span>
          Email de contacto <small>(no se publicará)</small>
        </span>
        <input name="contactEmail" type="email" maxlength="254" required autocomplete="email" />
      </label>
    </div>

    <label>
      <span>Tu historia</span>
      <textarea
        name="story"
        rows="6"
        maxlength="1200"
        required
        placeholder="Qué te llevó allí, qué echas de menos o cómo sigues conectado con Palomares…"
      ></textarea>
    </label>

    <label class="world-form-consent">
      <input name="consent" type="checkbox" required />
      <span>
        Acepto que esta historia se revise y, si se aprueba, se publique con el nombre, ciudad, país
        y texto indicados. La posición del mapa será aproximada.
      </span>
    </label>

    <label class="world-form-honeypot" aria-hidden="true">
      <span>Deja este campo vacío</span>
      <input name="website" type="text" tabindex="-1" autocomplete="off" />
    </label>

    <div class="world-form-actions">
      <button type="submit">Enviar propuesta</button>
      <p data-form-status aria-live="polite">
        La propuesta quedará pendiente de revisión.
      </p>
    </div>
  </form>
</section>

