{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "description",
          "date",
          "sourceName",
          "sourceUrl",
          "category",
          "localRelevance",
          "bodyMarkdown"
        ],
        "properties": {
          "type": { "const": "news" },
          "title": { "type": "string", "minLength": 8, "maxLength": 160 },
          "description": { "type": "string", "minLength": 20, "maxLength": 320 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "sourceName": { "type": "string", "minLength": 2, "maxLength": 100 },
          "sourceUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
          "category": {
            "type": "string",
            "enum": [
              "Cultura y tradiciones",
              "Economía y comercio",
              "Educación y comunidad",
              "Infraestructuras",
              "Medio ambiente e infraestructuras",
              "Movilidad e infraestructuras",
              "Municipio y servicios",
              "Patrimonio y cultura",
              "Sucesos y emergencias"
            ]
          },
          "localRelevance": { "type": "string", "minLength": 20, "maxLength": 500 },
          "bodyMarkdown": { "type": "string", "minLength": 80, "maxLength": 5000 }
        }
      }
    }
  }
}
