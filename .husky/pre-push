#!/usr/bin/env sh

set -eu

echo '→ Comprobando formato...'
pnpm format:check

echo '→ Ejecutando ESLint...'
pnpm lint

echo '→ Ejecutando tests unitarios...'
pnpm test

echo '→ Ejecutando tests E2E...'
CI=1 pnpm test:e2e

echo '→ Verificando la navegación con transiciones desactivadas...'
PUBLIC_PAGE_TRANSITIONS_ENABLED=false CI=1 pnpm exec playwright test tests/e2e/page-transition-feature-flag.spec.ts --retries=0

echo '→ Construyendo la aplicación...'
pnpm run build

echo '✓ Validación pre-push completada.'
