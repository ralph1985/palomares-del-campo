#!/usr/bin/env sh

set -eu

echo '→ Comprobando formato...'
pnpm format:check

echo '→ Ejecutando ESLint...'
pnpm lint

echo '→ Ejecutando tests unitarios...'
pnpm test

echo '→ Ejecutando tests E2E...'
CI=1 pnpm test:e2e

echo '→ Verificando la navegación con transiciones desactivadas...'
PUBLIC_PAGE_TRANSITIONS_ENABLED=false CI=1 pnpm exec playwright test tests/e2e/page-transition-feature-flag.spec.ts --retries=0

echo '→ Verificando Palomareños con la feature flag desactivada...'
PUBLIC_PALOMARENOS_ENABLED=false CI=1 pnpm exec playwright test tests/e2e/palomarenos-feature-flag.spec.ts --retries=0

echo '→ Construyendo con las funciones de decisión desactivadas...'
PUBLIC_PALOMARENOS_ENABLED=false PUBLIC_BALL_GAME_ENABLED=false pnpm build

echo '→ Verificando los 404 reales de las rutas desactivadas...'
PUBLIC_PALOMARENOS_ENABLED=false PUBLIC_BALL_GAME_ENABLED=false PLAYWRIGHT_USE_PREVIEW=true CI=1 pnpm exec playwright test tests/e2e/decision-presentations-disabled.spec.ts --retries=0

echo '→ Construyendo la aplicación...'
PUBLIC_PALOMARENOS_ENABLED=true PUBLIC_BALL_GAME_ENABLED=true pnpm run build

echo '✓ Validación pre-push completada.'
